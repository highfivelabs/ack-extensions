# Environment identifiers for live tests and offload runs. Copy to .env
# (git-ignored; Taskfile.yml loads it) and fill in real values. Never
# commit .env. Placeholders only here.

# The only AWS account live tests may touch (docs/live-runs.md): its
# 12-digit ID. hack/live/run.sh and cloudcontrol/test/live refuse to run
# without it. Set by whoever runs live tests, from the sandbox account
# the builder created.
AWS_SANDBOX_ACCOUNT_ID=000000000000

# Offload (scripts/offload): the GCP project the Spot VMs run in, its
# artifacts bucket, and the runner service account the sandbox account's
# role trusts. From the offload setup of the GCP organization.
OFFLOAD_PROJECT=my-offload-project
OFFLOAD_BUCKET=gs://my-offload-project-offload
OFFLOAD_SA=offload-runner@my-offload-project.iam.gserviceaccount.com
