{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlAgentRegistryRegistry",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentRegistryRegistryCreate",
      "Effect": "Allow",
      "Action": [
        "agent-registry:CreateRegistry",
        "agent-registry:GetRegistry",
        "agent-registry:ListTagsForResource",
        "agent-registry:TagResource",
        "bedrock-agentcore:CreateWorkloadIdentity",
        "iam:CreateServiceLinkedRole",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentRegistryRegistryRead",
      "Effect": "Allow",
      "Action": [
        "agent-registry:GetRegistry",
        "agent-registry:ListTagsForResource",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentRegistryRegistryUpdate",
      "Effect": "Allow",
      "Action": [
        "agent-registry:GetRegistry",
        "agent-registry:ListTagsForResource",
        "agent-registry:TagResource",
        "agent-registry:UntagResource",
        "agent-registry:UpdateRegistry",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentRegistryRegistryDelete",
      "Effect": "Allow",
      "Action": [
        "agent-registry:DeleteRegistry",
        "agent-registry:GetRegistry",
        "bedrock-agentcore:DeleteWorkloadIdentity"
      ],
      "Resource": "*"
    }
  ]
}
