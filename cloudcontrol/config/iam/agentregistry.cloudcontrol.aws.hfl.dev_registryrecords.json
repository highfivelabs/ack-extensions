{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlAgentRegistryRegistryRecord",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentRegistryRegistryRecordCreate",
      "Effect": "Allow",
      "Action": [
        "agent-registry:CreateRegistryRecord",
        "agent-registry:GetRegistryRecord",
        "agent-registry:ListTagsForResource",
        "agent-registry:TagResource",
        "bedrock-agentcore:GetResourceOauth2Token",
        "bedrock-agentcore:GetWorkloadAccessToken",
        "iam:PassRole",
        "kms:Decrypt",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentRegistryRegistryRecordRead",
      "Effect": "Allow",
      "Action": [
        "agent-registry:GetRegistryRecord",
        "agent-registry:ListTagsForResource",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentRegistryRegistryRecordUpdate",
      "Effect": "Allow",
      "Action": [
        "agent-registry:GetRegistryRecord",
        "agent-registry:ListTagsForResource",
        "agent-registry:TagResource",
        "agent-registry:UntagResource",
        "agent-registry:UpdateRegistryRecord",
        "bedrock-agentcore:GetResourceOauth2Token",
        "bedrock-agentcore:GetWorkloadAccessToken",
        "iam:PassRole",
        "kms:Decrypt",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentRegistryRegistryRecordDelete",
      "Effect": "Allow",
      "Action": [
        "agent-registry:DeleteRegistryRecord",
        "agent-registry:GetRegistryRecord",
        "agent-registry:ListTagsForResource",
        "kms:Decrypt"
      ],
      "Resource": "*"
    }
  ]
}
