{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlApiGatewayAccount",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayAccountCreate",
      "Effect": "Allow",
      "Action": [
        "apigateway:PATCH",
        "iam:GetRole",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayAccountRead",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayAccountUpdate",
      "Effect": "Allow",
      "Action": [
        "apigateway:PATCH",
        "iam:GetRole",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayAccountDelete",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": "*"
    }
  ]
}
