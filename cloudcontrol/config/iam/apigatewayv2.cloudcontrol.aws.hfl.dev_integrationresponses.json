{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlApiGatewayV2IntegrationResponse",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayV2IntegrationResponseCreate",
      "Effect": "Allow",
      "Action": [
        "apigateway:POST"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayV2IntegrationResponseRead",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayV2IntegrationResponseUpdate",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:PUT"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayV2IntegrationResponseDelete",
      "Effect": "Allow",
      "Action": [
        "apigateway:DELETE",
        "apigateway:GET"
      ],
      "Resource": "*"
    }
  ]
}
