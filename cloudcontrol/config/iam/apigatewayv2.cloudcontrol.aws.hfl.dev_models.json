{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlApiGatewayV2Model",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayV2ModelCreate",
      "Effect": "Allow",
      "Action": [
        "apigateway:POST"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayV2ModelRead",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayV2ModelUpdate",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:PUT"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayV2ModelDelete",
      "Effect": "Allow",
      "Action": [
        "apigateway:DELETE",
        "apigateway:GET"
      ],
      "Resource": "*"
    }
  ]
}
