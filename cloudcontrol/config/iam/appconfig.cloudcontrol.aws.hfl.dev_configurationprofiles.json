{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlAppConfigConfigurationProfile",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppConfigConfigurationProfileCreate",
      "Effect": "Allow",
      "Action": [
        "appconfig:CreateConfigurationProfile",
        "appconfig:GetConfigurationProfile",
        "appconfig:ListTagsForResource",
        "appconfig:TagResource",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppConfigConfigurationProfileRead",
      "Effect": "Allow",
      "Action": [
        "appconfig:GetConfigurationProfile",
        "appconfig:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppConfigConfigurationProfileUpdate",
      "Effect": "Allow",
      "Action": [
        "appconfig:TagResource",
        "appconfig:UntagResource",
        "appconfig:UpdateConfigurationProfile",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppConfigConfigurationProfileDelete",
      "Effect": "Allow",
      "Action": [
        "appconfig:DeleteConfigurationProfile"
      ],
      "Resource": "*"
    }
  ]
}
