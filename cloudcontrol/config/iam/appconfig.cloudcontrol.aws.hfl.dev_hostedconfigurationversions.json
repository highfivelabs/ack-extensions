{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlAppConfigHostedConfigurationVersion",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppConfigHostedConfigurationVersionCreate",
      "Effect": "Allow",
      "Action": [
        "appconfig:CreateHostedConfigurationVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppConfigHostedConfigurationVersionRead",
      "Effect": "Allow",
      "Action": [
        "appconfig:GetHostedConfigurationVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AppConfigHostedConfigurationVersionDelete",
      "Effect": "Allow",
      "Action": [
        "appconfig:DeleteHostedConfigurationVersion"
      ],
      "Resource": "*"
    }
  ]
}
