{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlBackupRestoreTestingPlan",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BackupRestoreTestingPlanCreate",
      "Effect": "Allow",
      "Action": [
        "backup:CreateRestoreTestingPlan",
        "backup:GetRestoreTestingPlan",
        "backup:ListTags",
        "backup:TagResource",
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BackupRestoreTestingPlanRead",
      "Effect": "Allow",
      "Action": [
        "backup:GetRestoreTestingPlan",
        "backup:ListTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BackupRestoreTestingPlanUpdate",
      "Effect": "Allow",
      "Action": [
        "backup:GetRestoreTestingPlan",
        "backup:ListTags",
        "backup:TagResource",
        "backup:UntagResource",
        "backup:UpdateRestoreTestingPlan"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BackupRestoreTestingPlanDelete",
      "Effect": "Allow",
      "Action": [
        "backup:DeleteRestoreTestingPlan",
        "backup:GetRestoreTestingPlan"
      ],
      "Resource": "*"
    }
  ]
}
