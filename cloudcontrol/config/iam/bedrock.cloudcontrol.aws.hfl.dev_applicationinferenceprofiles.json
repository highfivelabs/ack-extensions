{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlBedrockApplicationInferenceProfile",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockApplicationInferenceProfileCreate",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateInferenceProfile",
        "bedrock:GetInferenceProfile",
        "bedrock:ListTagsForResource",
        "bedrock:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockApplicationInferenceProfileRead",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetInferenceProfile",
        "bedrock:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockApplicationInferenceProfileUpdate",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetInferenceProfile",
        "bedrock:ListTagsForResource",
        "bedrock:TagResource",
        "bedrock:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockApplicationInferenceProfileDelete",
      "Effect": "Allow",
      "Action": [
        "bedrock:DeleteInferenceProfile",
        "bedrock:GetInferenceProfile"
      ],
      "Resource": "*"
    }
  ]
}
