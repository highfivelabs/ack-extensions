{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlBedrockBlueprint",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockBlueprintCreate",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateBlueprint",
        "bedrock:GetBlueprint",
        "bedrock:ListTagsForResource",
        "bedrock:TagResource",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockBlueprintRead",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetBlueprint",
        "bedrock:ListTagsForResource",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockBlueprintUpdate",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetBlueprint",
        "bedrock:ListTagsForResource",
        "bedrock:TagResource",
        "bedrock:UntagResource",
        "bedrock:UpdateBlueprint",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockBlueprintDelete",
      "Effect": "Allow",
      "Action": [
        "bedrock:DeleteBlueprint",
        "bedrock:GetBlueprint",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    }
  ]
}
