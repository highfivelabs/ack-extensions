{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlBedrockGuardrail",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockGuardrailCreate",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateGuardrail",
        "bedrock:GetGuardrail",
        "bedrock:ListTagsForResource",
        "bedrock:TagResource",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockGuardrailRead",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetGuardrail",
        "bedrock:ListTagsForResource",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockGuardrailUpdate",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetGuardrail",
        "bedrock:ListTagsForResource",
        "bedrock:TagResource",
        "bedrock:UntagResource",
        "bedrock:UpdateGuardrail",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockGuardrailDelete",
      "Effect": "Allow",
      "Action": [
        "bedrock:DeleteGuardrail",
        "bedrock:GetGuardrail",
        "kms:Decrypt",
        "kms:RetireGrant"
      ],
      "Resource": "*"
    }
  ]
}
