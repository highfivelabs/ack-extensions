{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlBedrockSession",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockSessionCreate",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateSession",
        "bedrock:GetSession",
        "bedrock:TagResource",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockSessionRead",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetSession",
        "bedrock:ListTagsForResource",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockSessionUpdate",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetSession",
        "bedrock:ListTagsForResource",
        "bedrock:TagResource",
        "bedrock:UntagResource",
        "bedrock:UpdateSession",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockSessionDelete",
      "Effect": "Allow",
      "Action": [
        "bedrock:DeleteSession",
        "bedrock:EndSession",
        "bedrock:GetSession",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    }
  ]
}
