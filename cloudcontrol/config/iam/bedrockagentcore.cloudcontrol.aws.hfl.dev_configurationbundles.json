{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlBedrockAgentCoreConfigurationBundle",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockAgentCoreConfigurationBundleCreate",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateConfigurationBundle",
        "bedrock-agentcore:GetConfigurationBundle",
        "bedrock-agentcore:ListTagsForResource",
        "bedrock-agentcore:TagResource",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo",
        "kms:RetireGrant"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockAgentCoreConfigurationBundleRead",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetConfigurationBundle",
        "bedrock-agentcore:ListTagsForResource",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockAgentCoreConfigurationBundleUpdate",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetConfigurationBundle",
        "bedrock-agentcore:ListTagsForResource",
        "bedrock-agentcore:TagResource",
        "bedrock-agentcore:UntagResource",
        "bedrock-agentcore:UpdateConfigurationBundle",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo",
        "kms:RetireGrant"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockAgentCoreConfigurationBundleDelete",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:DeleteConfigurationBundle",
        "bedrock-agentcore:GetConfigurationBundle",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:RetireGrant"
      ],
      "Resource": "*"
    }
  ]
}
