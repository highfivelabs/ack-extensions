{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlBedrockAgentCoreOAuth2CredentialProvider",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockAgentCoreOAuth2CredentialProviderCreate",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateOauth2CredentialProvider",
        "bedrock-agentcore:CreateTokenVault",
        "bedrock-agentcore:GetOauth2CredentialProvider",
        "bedrock-agentcore:TagResource",
        "ec2:CreateNetworkInterface",
        "iam:CreateServiceLinkedRole",
        "kms:DescribeKey",
        "kms:GetPublicKey",
        "kms:Sign",
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "vpc-lattice:AssociateViaAWSService",
        "vpc-lattice:CreateServiceNetworkResourceAssociation",
        "vpc-lattice:DeleteServiceNetworkResourceAssociation",
        "vpc-lattice:GetResourceConfiguration",
        "vpc-lattice:GetServiceNetworkResourceAssociation",
        "vpc-lattice:ListServiceNetworkResourceAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockAgentCoreOAuth2CredentialProviderRead",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetOauth2CredentialProvider",
        "bedrock-agentcore:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockAgentCoreOAuth2CredentialProviderUpdate",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetOauth2CredentialProvider",
        "bedrock-agentcore:ListTagsForResource",
        "bedrock-agentcore:TagResource",
        "bedrock-agentcore:UntagResource",
        "bedrock-agentcore:UpdateOauth2CredentialProvider",
        "ec2:CreateNetworkInterface",
        "iam:CreateServiceLinkedRole",
        "kms:DescribeKey",
        "kms:GetPublicKey",
        "kms:Sign",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "vpc-lattice:AssociateViaAWSService",
        "vpc-lattice:CreateServiceNetworkResourceAssociation",
        "vpc-lattice:DeleteServiceNetworkResourceAssociation",
        "vpc-lattice:GetResourceConfiguration",
        "vpc-lattice:GetServiceNetworkResourceAssociation",
        "vpc-lattice:ListServiceNetworkResourceAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockAgentCoreOAuth2CredentialProviderDelete",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:DeleteOauth2CredentialProvider",
        "bedrock-agentcore:GetOauth2CredentialProvider",
        "bedrock-agentcore:ListTagsForResource",
        "secretsmanager:DeleteSecret",
        "vpc-lattice:DeleteServiceNetworkResourceAssociation"
      ],
      "Resource": "*"
    }
  ]
}
