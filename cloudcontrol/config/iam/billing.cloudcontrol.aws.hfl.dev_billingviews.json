{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlBillingBillingView",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BillingBillingViewCreate",
      "Effect": "Allow",
      "Action": [
        "billing:AssociateSourceViews",
        "billing:CreateBillingView",
        "billing:GetBillingView",
        "billing:ListSourceViewsForBillingView",
        "billing:ListTagsForResource",
        "billing:TagResource",
        "billing:UseSourceView"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BillingBillingViewRead",
      "Effect": "Allow",
      "Action": [
        "billing:GetBillingView",
        "billing:ListSourceViewsForBillingView",
        "billing:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BillingBillingViewUpdate",
      "Effect": "Allow",
      "Action": [
        "billing:AssociateSourceViews",
        "billing:DisassociateSourceViews",
        "billing:GetBillingView",
        "billing:ListSourceViewsForBillingView",
        "billing:ListTagsForResource",
        "billing:TagResource",
        "billing:UntagResource",
        "billing:UpdateBillingView",
        "billing:UseSourceView"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BillingBillingViewDelete",
      "Effect": "Allow",
      "Action": [
        "billing:DeleteBillingView",
        "billing:GetBillingView"
      ],
      "Resource": "*"
    }
  ]
}
