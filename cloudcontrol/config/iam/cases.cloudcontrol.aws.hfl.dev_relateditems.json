{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCasesRelatedItem",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CasesRelatedItemCreate",
      "Effect": "Allow",
      "Action": [
        "cases:CreateRelatedItem",
        "cases:SearchRelatedItems",
        "cases:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CasesRelatedItemRead",
      "Effect": "Allow",
      "Action": [
        "cases:ListTagsForResource",
        "cases:SearchRelatedItems"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CasesRelatedItemUpdate",
      "Effect": "Allow",
      "Action": [
        "cases:ListTagsForResource",
        "cases:TagResource",
        "cases:UntagResource",
        "cases:UpdateRelatedItem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CasesRelatedItemDelete",
      "Effect": "Allow",
      "Action": [
        "cases:DeleteRelatedItem"
      ],
      "Resource": "*"
    }
  ]
}
