{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCasesTemplate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CasesTemplateCreate",
      "Effect": "Allow",
      "Action": [
        "cases:CreateTemplate",
        "cases:GetTemplate",
        "cases:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CasesTemplateRead",
      "Effect": "Allow",
      "Action": [
        "cases:GetTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CasesTemplateUpdate",
      "Effect": "Allow",
      "Action": [
        "cases:GetTemplate",
        "cases:TagResource",
        "cases:UntagResource",
        "cases:UpdateTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CasesTemplateDelete",
      "Effect": "Allow",
      "Action": [
        "cases:DeleteTemplate",
        "cases:UntagResource"
      ],
      "Resource": "*"
    }
  ]
}
