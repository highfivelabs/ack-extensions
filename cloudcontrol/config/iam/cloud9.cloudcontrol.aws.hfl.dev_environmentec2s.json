{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCloud9EnvironmentEC2",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Cloud9EnvironmentEC2Create",
      "Effect": "Allow",
      "Action": [
        "cloud9:CreateEnvironmentEC2",
        "cloud9:DescribeEnvironments",
        "cloud9:ListTagsForResource",
        "cloud9:TagResource",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "iam:CreateServiceLinkedRole",
        "ssm:StartSession"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Cloud9EnvironmentEC2Read",
      "Effect": "Allow",
      "Action": [
        "cloud9:DescribeEnvironments",
        "cloud9:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Cloud9EnvironmentEC2Update",
      "Effect": "Allow",
      "Action": [
        "cloud9:DescribeEnvironments",
        "cloud9:ListTagsForResource",
        "cloud9:TagResource",
        "cloud9:UntagResource",
        "cloud9:UpdateEnvironment"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Cloud9EnvironmentEC2Delete",
      "Effect": "Allow",
      "Action": [
        "cloud9:DeleteEnvironment",
        "cloud9:DescribeEnvironments",
        "ec2:DeleteSecurityGroup",
        "ec2:DescribeInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "*"
    }
  ]
}
