{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCloudFormationResourceDefaultVersion",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFormationResourceDefaultVersionCreate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:SetTypeDefaultVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFormationResourceDefaultVersionRead",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeType"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFormationResourceDefaultVersionUpdate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:SetTypeDefaultVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFormationResourceDefaultVersionDelete",
      "Effect": "Allow",
      "Action": [
        ""
      ],
      "Resource": "*"
    }
  ]
}
