{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCloudTrailChannel",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudTrailChannelCreate",
      "Effect": "Allow",
      "Action": [
        "CloudTrail:AddTags",
        "CloudTrail:CreateChannel"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudTrailChannelRead",
      "Effect": "Allow",
      "Action": [
        "CloudTrail:GetChannel",
        "CloudTrail:ListChannels",
        "CloudTrail:ListTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudTrailChannelUpdate",
      "Effect": "Allow",
      "Action": [
        "CloudTrail:AddTags",
        "CloudTrail:GetChannel",
        "CloudTrail:RemoveTags",
        "CloudTrail:UpdateChannel"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudTrailChannelDelete",
      "Effect": "Allow",
      "Action": [
        "CloudTrail:DeleteChannel"
      ],
      "Resource": "*"
    }
  ]
}
