{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCodeDeployApplication",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CodeDeployApplicationCreate",
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateApplication",
        "codedeploy:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CodeDeployApplicationRead",
      "Effect": "Allow",
      "Action": [
        "codedeploy:GetApplication",
        "codedeploy:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CodeDeployApplicationUpdate",
      "Effect": "Allow",
      "Action": [
        "codedeploy:TagResource",
        "codedeploy:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CodeDeployApplicationDelete",
      "Effect": "Allow",
      "Action": [
        "codedeploy:DeleteApplication",
        "codedeploy:GetApplication"
      ],
      "Resource": "*"
    }
  ]
}
