{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCodeDeployDeploymentConfig",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CodeDeployDeploymentConfigCreate",
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateDeploymentConfig"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CodeDeployDeploymentConfigRead",
      "Effect": "Allow",
      "Action": [
        "codedeploy:GetDeploymentConfig"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CodeDeployDeploymentConfigDelete",
      "Effect": "Allow",
      "Action": [
        "codedeploy:DeleteDeploymentConfig",
        "codedeploy:GetDeploymentConfig"
      ],
      "Resource": "*"
    }
  ]
}
