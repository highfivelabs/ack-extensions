{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCognitoIdentityPoolRoleAttachment",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoIdentityPoolRoleAttachmentCreate",
      "Effect": "Allow",
      "Action": [
        "cognito-identity:GetIdentityPoolRoles",
        "cognito-identity:SetIdentityPoolRoles",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoIdentityPoolRoleAttachmentRead",
      "Effect": "Allow",
      "Action": [
        "cognito-identity:GetIdentityPoolRoles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoIdentityPoolRoleAttachmentUpdate",
      "Effect": "Allow",
      "Action": [
        "cognito-identity:GetIdentityPoolRoles",
        "cognito-identity:SetIdentityPoolRoles",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoIdentityPoolRoleAttachmentDelete",
      "Effect": "Allow",
      "Action": [
        "cognito-identity:GetIdentityPoolRoles",
        "cognito-identity:SetIdentityPoolRoles"
      ],
      "Resource": "*"
    }
  ]
}
