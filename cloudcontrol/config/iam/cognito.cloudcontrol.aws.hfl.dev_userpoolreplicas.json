{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCognitoUserPoolReplica",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolReplicaCreate",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPoolReplica",
        "cognito-idp:ListUserPoolReplicas",
        "cognito-idp:TagResource",
        "iam:CreateServiceLinkedRole",
        "iam:PassRole",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolReplicaRead",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:ListTagsForResource",
        "cognito-idp:ListUserPoolReplicas",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolReplicaUpdate",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:ListUserPoolReplicas",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolReplicaDelete",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DeleteUserPoolReplica",
        "cognito-idp:DescribeUserPool",
        "cognito-idp:ListUserPoolReplicas",
        "iam:PassRole",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "*"
    }
  ]
}
