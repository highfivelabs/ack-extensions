{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCognitoUserPoolUser",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolUserCreate",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminGetUser",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolUserRead",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminGetUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolUserDelete",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminDeleteUser"
      ],
      "Resource": "*"
    }
  ]
}
