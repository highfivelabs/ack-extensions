{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCognitoUserPoolUserToGroupAttachment",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolUserToGroupAttachmentCreate",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminAddUserToGroup",
        "cognito-idp:AdminListGroupsForUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolUserToGroupAttachmentRead",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminListGroupsForUser"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPoolUserToGroupAttachmentDelete",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminListGroupsForUser",
        "cognito-idp:AdminRemoveUserFromGroup"
      ],
      "Resource": "*"
    }
  ]
}
