{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlComprehendEntityRecognizerEndpoint",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComprehendEntityRecognizerEndpointCreate",
      "Effect": "Allow",
      "Action": [
        "comprehend:CreateEndpoint",
        "comprehend:DescribeEndpoint",
        "comprehend:ListTagsForResource",
        "comprehend:TagResource",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComprehendEntityRecognizerEndpointRead",
      "Effect": "Allow",
      "Action": [
        "comprehend:DescribeEndpoint",
        "comprehend:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComprehendEntityRecognizerEndpointUpdate",
      "Effect": "Allow",
      "Action": [
        "comprehend:DescribeEndpoint",
        "comprehend:ListTagsForResource",
        "comprehend:TagResource",
        "comprehend:UntagResource",
        "comprehend:UpdateEndpoint",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComprehendEntityRecognizerEndpointDelete",
      "Effect": "Allow",
      "Action": [
        "comprehend:DeleteEndpoint",
        "comprehend:DescribeEndpoint",
        "comprehend:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
