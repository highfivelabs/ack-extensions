{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlComputeOptimizerAutomationRule",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComputeOptimizerAutomationRuleCreate",
      "Effect": "Allow",
      "Action": [
        "aco-automation:CreateAutomationRule",
        "aco-automation:GetAutomationRule",
        "aco-automation:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComputeOptimizerAutomationRuleRead",
      "Effect": "Allow",
      "Action": [
        "aco-automation:GetAutomationRule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComputeOptimizerAutomationRuleUpdate",
      "Effect": "Allow",
      "Action": [
        "aco-automation:GetAutomationRule",
        "aco-automation:TagResource",
        "aco-automation:UntagResource",
        "aco-automation:UpdateAutomationRule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComputeOptimizerAutomationRuleDelete",
      "Effect": "Allow",
      "Action": [
        "aco-automation:DeleteAutomationRule",
        "aco-automation:GetAutomationRule"
      ],
      "Resource": "*"
    }
  ]
}
