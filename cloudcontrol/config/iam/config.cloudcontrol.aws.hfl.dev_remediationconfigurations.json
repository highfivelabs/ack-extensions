{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlConfigRemediationConfiguration",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConfigRemediationConfigurationCreate",
      "Effect": "Allow",
      "Action": [
        "config:DescribeRemediationConfigurations",
        "config:PutRemediationConfigurations",
        "iam:CreateServiceLinkedRole",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConfigRemediationConfigurationRead",
      "Effect": "Allow",
      "Action": [
        "config:DescribeRemediationConfigurations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConfigRemediationConfigurationUpdate",
      "Effect": "Allow",
      "Action": [
        "config:DescribeRemediationConfigurations",
        "config:PutRemediationConfigurations",
        "iam:CreateServiceLinkedRole",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConfigRemediationConfigurationDelete",
      "Effect": "Allow",
      "Action": [
        "config:DeleteRemediationConfiguration"
      ],
      "Resource": "*"
    }
  ]
}
