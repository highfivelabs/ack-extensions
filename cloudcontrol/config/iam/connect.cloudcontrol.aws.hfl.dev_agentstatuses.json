{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlConnectAgentStatus",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectAgentStatusCreate",
      "Effect": "Allow",
      "Action": [
        "connect:CreateAgentStatus",
        "connect:ListAgentStatuses",
        "connect:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectAgentStatusRead",
      "Effect": "Allow",
      "Action": [
        "connect:DescribeAgentStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectAgentStatusUpdate",
      "Effect": "Allow",
      "Action": [
        "connect:TagResource",
        "connect:UntagResource",
        "connect:UpdateAgentStatus"
      ],
      "Resource": "*"
    }
  ]
}
