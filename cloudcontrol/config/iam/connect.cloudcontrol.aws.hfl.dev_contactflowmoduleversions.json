{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlConnectContactFlowModuleVersion",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectContactFlowModuleVersionCreate",
      "Effect": "Allow",
      "Action": [
        "connect:CreateContactFlowModuleVersion",
        "connect:DescribeContactFlowModule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectContactFlowModuleVersionRead",
      "Effect": "Allow",
      "Action": [
        "connect:DescribeContactFlowModule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectContactFlowModuleVersionUpdate",
      "Effect": "Allow",
      "Action": [
        "connect:DescribeContactFlowModule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectContactFlowModuleVersionDelete",
      "Effect": "Allow",
      "Action": [
        "connect:DeleteContactFlowModuleVersion"
      ],
      "Resource": "*"
    }
  ]
}
