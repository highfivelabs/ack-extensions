{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlConnectDataLakeAssociation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectDataLakeAssociationCreate",
      "Effect": "Allow",
      "Action": [
        "connect:AssociateAnalyticsDataSet",
        "connect:ListAnalyticsDataAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectDataLakeAssociationRead",
      "Effect": "Allow",
      "Action": [
        "connect:ListAnalyticsDataAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectDataLakeAssociationDelete",
      "Effect": "Allow",
      "Action": [
        "connect:DisassociateAnalyticsDataSet",
        "connect:ListAnalyticsDataAssociations"
      ],
      "Resource": "*"
    }
  ]
}
