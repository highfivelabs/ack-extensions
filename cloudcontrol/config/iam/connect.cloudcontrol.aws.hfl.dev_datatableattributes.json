{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlConnectDataTableAttribute",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectDataTableAttributeCreate",
      "Effect": "Allow",
      "Action": [
        "connect:CreateDataTableAttribute",
        "connect:ListDataTableAttributes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectDataTableAttributeRead",
      "Effect": "Allow",
      "Action": [
        "connect:ListDataTableAttributes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectDataTableAttributeUpdate",
      "Effect": "Allow",
      "Action": [
        "connect:UpdateDataTableAttribute"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConnectDataTableAttributeDelete",
      "Effect": "Allow",
      "Action": [
        "connect:DeleteDataTableAttribute",
        "connect:ListDataTableAttributes"
      ],
      "Resource": "*"
    }
  ]
}
