{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCustomerProfilesCalculatedAttributeDefinition",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CustomerProfilesCalculatedAttributeDefinitionCreate",
      "Effect": "Allow",
      "Action": [
        "profile:CreateCalculatedAttributeDefinition",
        "profile:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CustomerProfilesCalculatedAttributeDefinitionRead",
      "Effect": "Allow",
      "Action": [
        "profile:GetCalculatedAttributeDefinition",
        "profile:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CustomerProfilesCalculatedAttributeDefinitionUpdate",
      "Effect": "Allow",
      "Action": [
        "profile:GetCalculatedAttributeDefinition",
        "profile:ListTagsForResource",
        "profile:TagResource",
        "profile:UntagResource",
        "profile:UpdateCalculatedAttributeDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CustomerProfilesCalculatedAttributeDefinitionDelete",
      "Effect": "Allow",
      "Action": [
        "profile:DeleteCalculatedAttributeDefinition"
      ],
      "Resource": "*"
    }
  ]
}
