{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlCustomerProfilesEventTrigger",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CustomerProfilesEventTriggerCreate",
      "Effect": "Allow",
      "Action": [
        "profile:CreateEventTrigger",
        "profile:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CustomerProfilesEventTriggerRead",
      "Effect": "Allow",
      "Action": [
        "profile:GetEventTrigger",
        "profile:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CustomerProfilesEventTriggerUpdate",
      "Effect": "Allow",
      "Action": [
        "profile:GetEventTrigger",
        "profile:ListTagsForResource",
        "profile:TagResource",
        "profile:UntagResource",
        "profile:UpdateEventTrigger"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CustomerProfilesEventTriggerDelete",
      "Effect": "Allow",
      "Action": [
        "profile:DeleteEventTrigger"
      ],
      "Resource": "*"
    }
  ]
}
