{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlDataSyncLocationAzureBlob",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataSyncLocationAzureBlobCreate",
      "Effect": "Allow",
      "Action": [
        "datasync:CreateLocationAzureBlob",
        "datasync:DescribeLocationAzureBlob",
        "datasync:ListTagsForResource",
        "datasync:TagResource",
        "iam:CreateServiceLinkedRole",
        "iam:PassRole",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataSyncLocationAzureBlobRead",
      "Effect": "Allow",
      "Action": [
        "datasync:DescribeLocationAzureBlob",
        "datasync:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataSyncLocationAzureBlobUpdate",
      "Effect": "Allow",
      "Action": [
        "datasync:DescribeLocationAzureBlob",
        "datasync:ListTagsForResource",
        "datasync:TagResource",
        "datasync:UntagResource",
        "datasync:UpdateLocationAzureBlob",
        "iam:CreateServiceLinkedRole",
        "iam:PassRole",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecret"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataSyncLocationAzureBlobDelete",
      "Effect": "Allow",
      "Action": [
        "datasync:DeleteLocation",
        "secretsmanager:DeleteSecret"
      ],
      "Resource": "*"
    }
  ]
}
