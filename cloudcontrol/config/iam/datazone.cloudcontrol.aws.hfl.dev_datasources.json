{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlDataZoneDataSource",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataZoneDataSourceCreate",
      "Effect": "Allow",
      "Action": [
        "datazone:CreateDataSource",
        "datazone:DeleteDataSource",
        "datazone:GetDataSource",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataZoneDataSourceRead",
      "Effect": "Allow",
      "Action": [
        "datazone:GetDataSource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataZoneDataSourceUpdate",
      "Effect": "Allow",
      "Action": [
        "datazone:DeleteDataSource",
        "datazone:GetDataSource",
        "datazone:UpdateDataSource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataZoneDataSourceDelete",
      "Effect": "Allow",
      "Action": [
        "datazone:DeleteDataSource",
        "datazone:GetDataSource"
      ],
      "Resource": "*"
    }
  ]
}
