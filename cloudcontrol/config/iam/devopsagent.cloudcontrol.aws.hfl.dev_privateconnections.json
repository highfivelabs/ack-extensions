{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlDevOpsAgentPrivateConnection",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DevOpsAgentPrivateConnectionCreate",
      "Effect": "Allow",
      "Action": [
        "aidevops:CreatePrivateConnection",
        "aidevops:DescribePrivateConnection",
        "aidevops:ListTagsForResource",
        "aidevops:TagResource",
        "ec2:DescribeVpcs",
        "iam:CreateServiceLinkedRole",
        "vpc-lattice:AssociateViaAWSService",
        "vpc-lattice:AssociateViaService",
        "vpc-lattice:CreateServiceNetworkResourceAssociation",
        "vpc-lattice:GetResourceConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DevOpsAgentPrivateConnectionRead",
      "Effect": "Allow",
      "Action": [
        "aidevops:DescribePrivateConnection",
        "aidevops:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DevOpsAgentPrivateConnectionUpdate",
      "Effect": "Allow",
      "Action": [
        "aidevops:DescribePrivateConnection",
        "aidevops:ListTagsForResource",
        "aidevops:TagResource",
        "aidevops:UntagResource",
        "aidevops:UpdatePrivateConnectionCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DevOpsAgentPrivateConnectionDelete",
      "Effect": "Allow",
      "Action": [
        "aidevops:DeletePrivateConnection",
        "aidevops:DescribePrivateConnection"
      ],
      "Resource": "*"
    }
  ]
}
