{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlDirectConnectDirectConnectGatewayAssociation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DirectConnectDirectConnectGatewayAssociationCreate",
      "Effect": "Allow",
      "Action": [
        "directconnect:CreateDirectConnectGatewayAssociation",
        "directconnect:CreateDirectConnectGatewayAssociationProposal",
        "directconnect:DescribeDirectConnectGatewayAssociations",
        "sts:AssumeRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DirectConnectDirectConnectGatewayAssociationRead",
      "Effect": "Allow",
      "Action": [
        "directconnect:DescribeDirectConnectGatewayAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DirectConnectDirectConnectGatewayAssociationUpdate",
      "Effect": "Allow",
      "Action": [
        "directconnect:DescribeDirectConnectGatewayAssociations",
        "directconnect:UpdateDirectConnectGatewayAssociation",
        "sts:AssumeRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DirectConnectDirectConnectGatewayAssociationDelete",
      "Effect": "Allow",
      "Action": [
        "directconnect:DeleteDirectConnectGatewayAssociation",
        "directconnect:DescribeDirectConnectGatewayAssociations"
      ],
      "Resource": "*"
    }
  ]
}
