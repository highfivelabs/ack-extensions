{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlEC2EnclaveCertificateIamRoleAssociation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2EnclaveCertificateIamRoleAssociationCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateEnclaveCertificateIamRole",
        "ec2:GetAssociatedEnclaveCertificateIamRoles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2EnclaveCertificateIamRoleAssociationRead",
      "Effect": "Allow",
      "Action": [
        "ec2:GetAssociatedEnclaveCertificateIamRoles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2EnclaveCertificateIamRoleAssociationDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DisassociateEnclaveCertificateIamRole",
        "ec2:GetAssociatedEnclaveCertificateIamRoles"
      ],
      "Resource": "*"
    }
  ]
}
