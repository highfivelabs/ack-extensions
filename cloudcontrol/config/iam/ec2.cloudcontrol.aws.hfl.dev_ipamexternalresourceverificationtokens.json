{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlEC2IpamExternalResourceVerificationToken",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2IpamExternalResourceVerificationTokenCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateIpamExternalResourceVerificationToken",
        "ec2:CreateTags",
        "ec2:DescribeIpamExternalResourceVerificationTokens"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2IpamExternalResourceVerificationTokenRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeIpamExternalResourceVerificationTokens"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2IpamExternalResourceVerificationTokenUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:DescribeIpamExternalResourceVerificationTokens"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2IpamExternalResourceVerificationTokenDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteIpamExternalResourceVerificationToken",
        "ec2:DeleteTags",
        "ec2:DescribeIpamExternalResourceVerificationTokens"
      ],
      "Resource": "*"
    }
  ]
}
