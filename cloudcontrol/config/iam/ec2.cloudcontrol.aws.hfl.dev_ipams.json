{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlEC2IPAM",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2IPAMCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateIpam",
        "ec2:CreateTags",
        "ec2:DescribeIpamResourceDiscoveries",
        "ec2:DescribeIpams",
        "ec2:ModifyIpamResourceDiscovery",
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2IPAMRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeIpamResourceDiscoveries",
        "ec2:DescribeIpams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2IPAMUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:DescribeIpamResourceDiscoveries",
        "ec2:DescribeIpams",
        "ec2:ModifyIpam",
        "ec2:ModifyIpamResourceDiscovery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2IPAMDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteIpam",
        "ec2:DeleteTags",
        "ec2:DescribeIpams"
      ],
      "Resource": "*"
    }
  ]
}
