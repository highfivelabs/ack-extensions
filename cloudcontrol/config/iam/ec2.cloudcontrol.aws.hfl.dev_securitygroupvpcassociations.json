{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlEC2SecurityGroupVpcAssociation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2SecurityGroupVpcAssociationCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateSecurityGroupVpc",
        "ec2:DescribeSecurityGroupVpcAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2SecurityGroupVpcAssociationRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroupVpcAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2SecurityGroupVpcAssociationDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroupVpcAssociations",
        "ec2:DisassociateSecurityGroupVpc"
      ],
      "Resource": "*"
    }
  ]
}
