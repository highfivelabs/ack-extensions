{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlEC2TrafficMirrorFilterRule",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TrafficMirrorFilterRuleCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:CreateTrafficMirrorFilterRule",
        "ec2:DescribeTrafficMirrorFilterRules"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TrafficMirrorFilterRuleRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeTrafficMirrorFilterRules"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TrafficMirrorFilterRuleUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:ModifyTrafficMirrorFilterRule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TrafficMirrorFilterRuleDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteTrafficMirrorFilterRule"
      ],
      "Resource": "*"
    }
  ]
}
