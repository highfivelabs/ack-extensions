{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlEC2TransitGatewayMulticastDomain",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TransitGatewayMulticastDomainCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:CreateTransitGatewayMulticastDomain",
        "ec2:DescribeTags",
        "ec2:DescribeTransitGatewayMulticastDomains"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TransitGatewayMulticastDomainRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeTags",
        "ec2:DescribeTransitGatewayMulticastDomains"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TransitGatewayMulticastDomainUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:DescribeTags",
        "ec2:DescribeTransitGatewayMulticastDomains"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TransitGatewayMulticastDomainDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteTags",
        "ec2:DeleteTransitGatewayMulticastDomain",
        "ec2:DescribeTags",
        "ec2:DescribeTransitGatewayMulticastDomains"
      ],
      "Resource": "*"
    }
  ]
}
