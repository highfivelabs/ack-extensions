{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlElasticBeanstalkConfigurationTemplate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ElasticBeanstalkConfigurationTemplateCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplate",
        "ec2:DescribeImages",
        "elasticbeanstalk:CreateConfigurationTemplate",
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutBucketAcl",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ElasticBeanstalkConfigurationTemplateRead",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplate",
        "elasticbeanstalk:DescribeConfigurationSettings",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ElasticBeanstalkConfigurationTemplateUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplate",
        "ec2:DescribeImages",
        "elasticbeanstalk:UpdateConfigurationTemplate",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ElasticBeanstalkConfigurationTemplateDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplate",
        "elasticbeanstalk:DeleteConfigurationTemplate",
        "elasticbeanstalk:DescribeConfigurationSettings",
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": "*"
    }
  ]
}
