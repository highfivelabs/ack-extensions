{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlEntityResolutionMatchingWorkflow",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EntityResolutionMatchingWorkflowCreate",
      "Effect": "Allow",
      "Action": [
        "entityresolution:CreateMatchingWorkflow",
        "entityresolution:GetMatchingWorkflow",
        "entityresolution:TagResource",
        "events:DeleteRule",
        "events:ListTargetsByRule",
        "events:PutRule",
        "events:PutTargets",
        "iam:PassRole",
        "kms:CreateGrant",
        "kms:DescribeKey",
        "profile:PutIntegration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EntityResolutionMatchingWorkflowRead",
      "Effect": "Allow",
      "Action": [
        "entityresolution:GetMatchingWorkflow",
        "entityresolution:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EntityResolutionMatchingWorkflowUpdate",
      "Effect": "Allow",
      "Action": [
        "entityresolution:GetMatchingWorkflow",
        "entityresolution:ListTagsForResource",
        "entityresolution:TagResource",
        "entityresolution:UntagResource",
        "entityresolution:UpdateMatchingWorkflow",
        "events:DeleteRule",
        "events:ListTargetsByRule",
        "events:PutRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "iam:PassRole",
        "kms:CreateGrant",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EntityResolutionMatchingWorkflowDelete",
      "Effect": "Allow",
      "Action": [
        "entityresolution:DeleteMatchingWorkflow",
        "entityresolution:GetMatchingWorkflow",
        "entityresolution:UntagResource",
        "events:DeleteRule",
        "events:ListTargetsByRule",
        "events:PutRule",
        "events:PutTargets",
        "events:RemoveTargets",
        "profile:DeleteIntegration"
      ],
      "Resource": "*"
    }
  ]
}
