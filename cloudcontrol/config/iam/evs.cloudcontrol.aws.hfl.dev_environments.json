{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlEVSEnvironment",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EVSEnvironmentCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateHosts",
        "ec2:CreateNetworkInterface",
        "ec2:CreatePlacementGroup",
        "ec2:CreateSubnet",
        "ec2:CreateTags",
        "ec2:DeleteNetworkInterface",
        "ec2:DeleteVolume",
        "ec2:DetachVolume",
        "ec2:ModifyNetworkInterfaceAttribute",
        "ec2:RunInstances",
        "evs:CreateEnvironment",
        "evs:GetEnvironment",
        "evs:ListTagsForResource",
        "evs:TagResource",
        "iam:CreateServiceLinkedRole",
        "kms:DescribeKey",
        "kms:ListKeysForService",
        "secretsmanager:BatchGetSecretValue",
        "secretsmanager:CreateSecret",
        "secretsmanager:GetRandomPassword",
        "secretsmanager:GetSecretValue",
        "secretsmanager:TagResource",
        "secretsmanager:UpdateSecret",
        "servicequotas:GetServiceQuota",
        "servicequotas:ListServiceQuotas",
        "support:DescribeServices",
        "support:DescribeSupportLevel"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EVSEnvironmentRead",
      "Effect": "Allow",
      "Action": [
        "evs:GetEnvironment",
        "evs:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EVSEnvironmentUpdate",
      "Effect": "Allow",
      "Action": [
        "evs:GetEnvironment",
        "evs:ListTagsForResource",
        "evs:TagResource",
        "evs:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EVSEnvironmentDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeletePlacementGroup",
        "ec2:DeleteSubnet",
        "ec2:DescribeHosts",
        "ec2:DetachNetworkInterface",
        "ec2:ReleaseHosts",
        "ec2:TerminateInstances",
        "evs:DeleteEnvironment",
        "evs:GetEnvironment",
        "evs:UntagResource",
        "secretsmanager:DeleteSecret"
      ],
      "Resource": "*"
    }
  ]
}
