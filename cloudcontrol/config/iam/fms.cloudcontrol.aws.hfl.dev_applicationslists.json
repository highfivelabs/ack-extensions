{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlFMSApplicationsList",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FMSApplicationsListCreate",
      "Effect": "Allow",
      "Action": [
        "fms:PutAppsList",
        "fms:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FMSApplicationsListRead",
      "Effect": "Allow",
      "Action": [
        "fms:GetAppsList",
        "fms:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FMSApplicationsListUpdate",
      "Effect": "Allow",
      "Action": [
        "fms:GetAppsList",
        "fms:ListTagsForResource",
        "fms:PutAppsList",
        "fms:TagResource",
        "fms:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FMSApplicationsListDelete",
      "Effect": "Allow",
      "Action": [
        "fms:DeleteAppsList"
      ],
      "Resource": "*"
    }
  ]
}
