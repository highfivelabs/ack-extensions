{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlGlobalAcceleratorListener",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlobalAcceleratorListenerCreate",
      "Effect": "Allow",
      "Action": [
        "globalaccelerator:CreateListener",
        "globalaccelerator:DescribeAccelerator",
        "globalaccelerator:DescribeListener"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlobalAcceleratorListenerRead",
      "Effect": "Allow",
      "Action": [
        "globalaccelerator:DescribeListener"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlobalAcceleratorListenerUpdate",
      "Effect": "Allow",
      "Action": [
        "globalaccelerator:DescribeAccelerator",
        "globalaccelerator:DescribeListener",
        "globalaccelerator:UpdateListener"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlobalAcceleratorListenerDelete",
      "Effect": "Allow",
      "Action": [
        "globalaccelerator:DeleteListener",
        "globalaccelerator:DescribeAccelerator",
        "globalaccelerator:DescribeListener"
      ],
      "Resource": "*"
    }
  ]
}
