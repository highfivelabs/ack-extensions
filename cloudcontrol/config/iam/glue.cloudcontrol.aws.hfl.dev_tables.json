{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlGlueTable",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlueTableCreate",
      "Effect": "Allow",
      "Action": [
        "glue:CreateTable",
        "glue:GetDatabase",
        "glue:GetSchemaVersion",
        "glue:GetTable",
        "glue:PassConnection",
        "iam:PassRole",
        "lakeformation:CreateTable",
        "lakeformation:DescribeLakeFormationIdentityCenterConfiguration",
        "lakeformation:DescribeResource",
        "lakeformation:GetDataAccess",
        "lakeformation:ListResources",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlueTableRead",
      "Effect": "Allow",
      "Action": [
        "glue:CreateTable",
        "glue:GetDatabase",
        "glue:GetTable",
        "lakeformation:CreateTable",
        "lakeformation:DescribeLakeFormationIdentityCenterConfiguration",
        "lakeformation:DescribeResource",
        "lakeformation:GetDataAccess",
        "lakeformation:ListResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlueTableUpdate",
      "Effect": "Allow",
      "Action": [
        "glue:CreateTable",
        "glue:GetSchemaVersion",
        "glue:GetTable",
        "glue:PassConnection",
        "glue:UpdateDatabase",
        "glue:UpdateTable",
        "iam:PassRole",
        "lakeformation:CreateTable",
        "lakeformation:DescribeLakeFormationIdentityCenterConfiguration",
        "lakeformation:DescribeResource",
        "lakeformation:GetDataAccess",
        "lakeformation:ListResources",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlueTableDelete",
      "Effect": "Allow",
      "Action": [
        "glue:CreateTable",
        "glue:DeleteTable",
        "glue:GetDatabase",
        "glue:GetTable",
        "lakeformation:CreateTable",
        "lakeformation:DescribeLakeFormationIdentityCenterConfiguration",
        "lakeformation:DescribeResource",
        "lakeformation:GetDataAccess",
        "lakeformation:ListResources"
      ],
      "Resource": "*"
    }
  ]
}
