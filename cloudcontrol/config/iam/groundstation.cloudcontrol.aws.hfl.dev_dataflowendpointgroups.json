{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlGroundStationDataflowEndpointGroup",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GroundStationDataflowEndpointGroupCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:describeAddresses",
        "ec2:describeNetworkInterfaces",
        "groundstation:CreateDataflowEndpointGroup",
        "groundstation:GetDataflowEndpointGroup",
        "groundstation:TagResource",
        "iam:PassRole",
        "iam:createServiceLinkedRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GroundStationDataflowEndpointGroupRead",
      "Effect": "Allow",
      "Action": [
        "groundstation:GetDataflowEndpointGroup",
        "groundstation:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GroundStationDataflowEndpointGroupUpdate",
      "Effect": "Allow",
      "Action": [
        "groundstation:ListTagsForResource",
        "groundstation:TagResource",
        "groundstation:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GroundStationDataflowEndpointGroupDelete",
      "Effect": "Allow",
      "Action": [
        "groundstation:DeleteDataflowEndpointGroup",
        "groundstation:GetDataflowEndpointGroup"
      ],
      "Resource": "*"
    }
  ]
}
