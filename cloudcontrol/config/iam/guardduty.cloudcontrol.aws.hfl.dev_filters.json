{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlGuardDutyFilter",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyFilterCreate",
      "Effect": "Allow",
      "Action": [
        "guardduty:CreateFilter",
        "guardduty:GetFilter",
        "guardduty:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyFilterRead",
      "Effect": "Allow",
      "Action": [
        "guardduty:GetFilter",
        "guardduty:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyFilterUpdate",
      "Effect": "Allow",
      "Action": [
        "guardduty:GetFilter",
        "guardduty:ListFilters",
        "guardduty:TagResource",
        "guardduty:UntagResource",
        "guardduty:UpdateFilter"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyFilterDelete",
      "Effect": "Allow",
      "Action": [
        "guardduty:DeleteFilter",
        "guardduty:GetFilter",
        "guardduty:ListDetectors",
        "guardduty:ListFilters"
      ],
      "Resource": "*"
    }
  ]
}
