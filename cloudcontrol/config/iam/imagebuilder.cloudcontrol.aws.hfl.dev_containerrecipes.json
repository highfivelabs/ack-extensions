{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlImageBuilderContainerRecipe",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageBuilderContainerRecipeCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ecr:DescribeRepositories",
        "iam:CreateServiceLinkedRole",
        "iam:GetRole",
        "imagebuilder:CreateContainerRecipe",
        "imagebuilder:GetComponent",
        "imagebuilder:GetContainerRecipe",
        "imagebuilder:GetImage",
        "imagebuilder:TagResource",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyPair",
        "kms:GenerateDataKeyPairWithoutPlaintext",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageBuilderContainerRecipeRead",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:GetContainerRecipe",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageBuilderContainerRecipeUpdate",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:TagResource",
        "imagebuilder:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageBuilderContainerRecipeDelete",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:DeleteContainerRecipe",
        "imagebuilder:GetContainerRecipe",
        "imagebuilder:UntagResource"
      ],
      "Resource": "*"
    }
  ]
}
