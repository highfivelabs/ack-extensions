{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlImageBuilderDistributionConfiguration",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageBuilderDistributionConfigurationCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:DescribeLaunchTemplates",
        "ec2:ModifyLaunchTemplate",
        "ecr:DescribeRepositories",
        "iam:CreateServiceLinkedRole",
        "iam:GetRole",
        "imagebuilder:CreateDistributionConfiguration",
        "imagebuilder:GetDistributionConfiguration",
        "imagebuilder:TagResource",
        "ssm:GetParameter"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageBuilderDistributionConfigurationRead",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:GetDistributionConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageBuilderDistributionConfigurationUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:DescribeLaunchTemplates",
        "ec2:ModifyLaunchTemplate",
        "ecr:DescribeRepositories",
        "imagebuilder:GetDistributionConfiguration",
        "imagebuilder:TagResource",
        "imagebuilder:UntagResource",
        "imagebuilder:UpdateDistributionConfiguration",
        "ssm:GetParameter"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ImageBuilderDistributionConfigurationDelete",
      "Effect": "Allow",
      "Action": [
        "imagebuilder:DeleteDistributionConfiguration",
        "imagebuilder:GetDistributionConfiguration",
        "imagebuilder:UntagResource"
      ],
      "Resource": "*"
    }
  ]
}
