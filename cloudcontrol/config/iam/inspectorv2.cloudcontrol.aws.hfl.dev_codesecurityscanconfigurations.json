{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlInspectorV2CodeSecurityScanConfiguration",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectorV2CodeSecurityScanConfigurationCreate",
      "Effect": "Allow",
      "Action": [
        "inspector2:CreateCodeSecurityScanConfiguration",
        "inspector2:GetCodeSecurityScanConfiguration",
        "inspector2:ListCodeSecurityScanConfigurations",
        "inspector2:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectorV2CodeSecurityScanConfigurationRead",
      "Effect": "Allow",
      "Action": [
        "inspector2:GetCodeSecurityScanConfiguration",
        "inspector2:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectorV2CodeSecurityScanConfigurationUpdate",
      "Effect": "Allow",
      "Action": [
        "inspector2:GetCodeSecurityScanConfiguration",
        "inspector2:ListTagsForResource",
        "inspector2:TagResource",
        "inspector2:UntagResource",
        "inspector2:UpdateCodeSecurityScanConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InspectorV2CodeSecurityScanConfigurationDelete",
      "Effect": "Allow",
      "Action": [
        "inspector2:DeleteCodeSecurityScanConfiguration",
        "inspector2:GetCodeSecurityScanConfiguration",
        "inspector2:ListCodeSecurityScanConfigurations"
      ],
      "Resource": "*"
    }
  ]
}
