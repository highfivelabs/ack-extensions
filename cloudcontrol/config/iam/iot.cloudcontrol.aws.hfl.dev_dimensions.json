{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIoTDimension",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTDimensionCreate",
      "Effect": "Allow",
      "Action": [
        "iot:CreateDimension",
        "iot:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTDimensionRead",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeDimension",
        "iot:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTDimensionUpdate",
      "Effect": "Allow",
      "Action": [
        "iot:ListTagsForResource",
        "iot:TagResource",
        "iot:UntagResource",
        "iot:UpdateDimension"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTDimensionDelete",
      "Effect": "Allow",
      "Action": [
        "iot:DeleteDimension",
        "iot:DescribeDimension"
      ],
      "Resource": "*"
    }
  ]
}
