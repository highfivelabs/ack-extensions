{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIoTJobTemplate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTJobTemplateCreate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iot:CreateJobTemplate",
        "iot:TagResource",
        "s3:GetObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTJobTemplateRead",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeJobTemplate",
        "iot:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTJobTemplateDelete",
      "Effect": "Allow",
      "Action": [
        "iot:DeleteJobTemplate"
      ],
      "Resource": "*"
    }
  ]
}
