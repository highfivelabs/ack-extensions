{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIoTLogging",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTLoggingCreate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iot:GetV2LoggingOptions",
        "iot:SetV2LoggingOptions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTLoggingRead",
      "Effect": "Allow",
      "Action": [
        "iot:GetV2LoggingOptions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTLoggingUpdate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iot:GetV2LoggingOptions",
        "iot:SetV2LoggingOptions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTLoggingDelete",
      "Effect": "Allow",
      "Action": [
        "iot:GetV2LoggingOptions",
        "iot:SetV2LoggingOptions"
      ],
      "Resource": "*"
    }
  ]
}
