{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIoTMitigationAction",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTMitigationActionCreate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iot:CreateMitigationAction",
        "iot:DescribeMitigationAction",
        "iot:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTMitigationActionRead",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeMitigationAction",
        "iot:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTMitigationActionUpdate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iot:ListTagsForResource",
        "iot:TagResource",
        "iot:UntagResource",
        "iot:UpdateMitigationAction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTMitigationActionDelete",
      "Effect": "Allow",
      "Action": [
        "iot:DeleteMitigationAction",
        "iot:DescribeMitigationAction"
      ],
      "Resource": "*"
    }
  ]
}
