{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIoTOTAUpdate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTOTAUpdateCreate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iot:CreateOTAUpdate",
        "iot:GetOTAUpdate",
        "iot:ListTagsForResource",
        "iot:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTOTAUpdateRead",
      "Effect": "Allow",
      "Action": [
        "iot:GetOTAUpdate",
        "iot:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTOTAUpdateUpdate",
      "Effect": "Allow",
      "Action": [
        "iot:GetOTAUpdate",
        "iot:ListTagsForResource",
        "iot:TagResource",
        "iot:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTOTAUpdateDelete",
      "Effect": "Allow",
      "Action": [
        "iot:DeleteOTAUpdate",
        "iot:DescribeJob",
        "iot:GetOTAUpdate",
        "iot:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
