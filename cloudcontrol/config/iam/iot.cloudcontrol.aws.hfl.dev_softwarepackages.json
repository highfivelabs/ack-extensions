{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIoTSoftwarePackage",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTSoftwarePackageCreate",
      "Effect": "Allow",
      "Action": [
        "iot:CreatePackage",
        "iot:GetIndexingConfiguration",
        "iot:GetPackage",
        "iot:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTSoftwarePackageRead",
      "Effect": "Allow",
      "Action": [
        "iot:GetPackage",
        "iot:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTSoftwarePackageUpdate",
      "Effect": "Allow",
      "Action": [
        "iot:CreatePackage",
        "iot:GetIndexingConfiguration",
        "iot:GetPackage",
        "iot:ListTagsForResource",
        "iot:TagResource",
        "iot:UntagResource",
        "iot:UpdatePackage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTSoftwarePackageDelete",
      "Effect": "Allow",
      "Action": [
        "iot:DeletePackage",
        "iot:DeletePackageVersion",
        "iot:GetIndexingConfiguration",
        "iot:GetPackage",
        "iot:GetPackageVersion",
        "iot:ListPackageVersions",
        "iot:UpdatePackage",
        "iot:UpdatePackageVersion"
      ],
      "Resource": "*"
    }
  ]
}
