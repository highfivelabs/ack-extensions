{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIoTStream",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTStreamCreate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iot:CreateStream",
        "iot:DescribeStream",
        "iot:ListTagsForResource",
        "iot:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTStreamRead",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeStream",
        "iot:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTStreamUpdate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "iot:DescribeStream",
        "iot:ListTagsForResource",
        "iot:TagResource",
        "iot:UntagResource",
        "iot:UpdateStream"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTStreamDelete",
      "Effect": "Allow",
      "Action": [
        "iot:DeleteStream"
      ],
      "Resource": "*"
    }
  ]
}
