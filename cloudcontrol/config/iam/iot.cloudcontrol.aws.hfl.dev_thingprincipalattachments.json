{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIoTThingPrincipalAttachment",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTThingPrincipalAttachmentCreate",
      "Effect": "Allow",
      "Action": [
        "iot:AttachThingPrincipal",
        "iot:ListThingPrincipalsV2"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTThingPrincipalAttachmentRead",
      "Effect": "Allow",
      "Action": [
        "iot:ListThingPrincipalsV2"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IoTThingPrincipalAttachmentDelete",
      "Effect": "Allow",
      "Action": [
        "iot:DetachThingPrincipal",
        "iot:ListThingPrincipalsV2"
      ],
      "Resource": "*"
    }
  ]
}
