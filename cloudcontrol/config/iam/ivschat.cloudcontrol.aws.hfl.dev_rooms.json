{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlIVSChatRoom",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IVSChatRoomCreate",
      "Effect": "Allow",
      "Action": [
        "ivschat:CreateRoom",
        "ivschat:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IVSChatRoomRead",
      "Effect": "Allow",
      "Action": [
        "ivschat:GetRoom",
        "ivschat:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IVSChatRoomUpdate",
      "Effect": "Allow",
      "Action": [
        "ivschat:ListTagsForResource",
        "ivschat:TagResource",
        "ivschat:UntagResource",
        "ivschat:UpdateRoom"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IVSChatRoomDelete",
      "Effect": "Allow",
      "Action": [
        "ivschat:DeleteRoom",
        "ivschat:UntagResource"
      ],
      "Resource": "*"
    }
  ]
}
