{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlKafkaConnectWorkerConfiguration",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KafkaConnectWorkerConfigurationCreate",
      "Effect": "Allow",
      "Action": [
        "kafkaconnect:CreateWorkerConfiguration",
        "kafkaconnect:DescribeWorkerConfiguration",
        "kafkaconnect:ListTagsForResource",
        "kafkaconnect:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KafkaConnectWorkerConfigurationRead",
      "Effect": "Allow",
      "Action": [
        "kafkaconnect:DescribeWorkerConfiguration",
        "kafkaconnect:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KafkaConnectWorkerConfigurationUpdate",
      "Effect": "Allow",
      "Action": [
        "kafkaconnect:DescribeWorkerConfiguration",
        "kafkaconnect:ListTagsForResource",
        "kafkaconnect:TagResource",
        "kafkaconnect:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KafkaConnectWorkerConfigurationDelete",
      "Effect": "Allow",
      "Action": [
        "kafkaconnect:DeleteWorkerConfiguration",
        "kafkaconnect:DescribeWorkerConfiguration"
      ],
      "Resource": "*"
    }
  ]
}
