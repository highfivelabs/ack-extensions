{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlLambdaCapacityProvider",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaCapacityProviderCreate",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole",
        "iam:PassRole",
        "kms:DescribeKey",
        "lambda:CreateCapacityProvider",
        "lambda:GetCapacityProvider",
        "lambda:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaCapacityProviderRead",
      "Effect": "Allow",
      "Action": [
        "lambda:GetCapacityProvider",
        "lambda:ListTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaCapacityProviderUpdate",
      "Effect": "Allow",
      "Action": [
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateCapacityProvider"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaCapacityProviderDelete",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteCapacityProvider",
        "lambda:GetCapacityProvider"
      ],
      "Resource": "*"
    }
  ]
}
