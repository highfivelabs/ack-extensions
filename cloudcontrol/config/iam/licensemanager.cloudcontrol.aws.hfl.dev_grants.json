{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlLicenseManagerGrant",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LicenseManagerGrantCreate",
      "Effect": "Allow",
      "Action": [
        "license-manager:CreateGrant",
        "license-manager:CreateGrantVersion",
        "license-manager:GetGrant",
        "license-manager:ListTagsForResource",
        "license-manager:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LicenseManagerGrantRead",
      "Effect": "Allow",
      "Action": [
        "license-manager:GetGrant",
        "license-manager:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LicenseManagerGrantUpdate",
      "Effect": "Allow",
      "Action": [
        "license-manager:CreateGrantVersion",
        "license-manager:GetGrant",
        "license-manager:ListTagsForResource",
        "license-manager:TagResource",
        "license-manager:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LicenseManagerGrantDelete",
      "Effect": "Allow",
      "Action": [
        "license-manager:DeleteGrant",
        "license-manager:GetGrant",
        "license-manager:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
