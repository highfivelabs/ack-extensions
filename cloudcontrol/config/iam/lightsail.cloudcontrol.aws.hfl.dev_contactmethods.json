{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlLightsailContactMethod",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LightsailContactMethodCreate",
      "Effect": "Allow",
      "Action": [
        "lightsail:CreateContactMethod",
        "lightsail:GetContactMethods"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LightsailContactMethodRead",
      "Effect": "Allow",
      "Action": [
        "lightsail:GetContactMethods"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LightsailContactMethodDelete",
      "Effect": "Allow",
      "Action": [
        "lightsail:DeleteContactMethod",
        "lightsail:GetContactMethods"
      ],
      "Resource": "*"
    }
  ]
}
