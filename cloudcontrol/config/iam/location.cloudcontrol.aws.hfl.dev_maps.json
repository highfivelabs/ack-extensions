{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlLocationMap",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LocationMapCreate",
      "Effect": "Allow",
      "Action": [
        "geo:CreateMap",
        "geo:DescribeMap",
        "geo:TagResource",
        "geo:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LocationMapRead",
      "Effect": "Allow",
      "Action": [
        "geo:DescribeMap"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LocationMapUpdate",
      "Effect": "Allow",
      "Action": [
        "geo:CreateMap",
        "geo:DescribeMap",
        "geo:TagResource",
        "geo:UntagResource",
        "geo:UpdateMap"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LocationMapDelete",
      "Effect": "Allow",
      "Action": [
        "geo:DeleteMap",
        "geo:DescribeMap"
      ],
      "Resource": "*"
    }
  ]
}
