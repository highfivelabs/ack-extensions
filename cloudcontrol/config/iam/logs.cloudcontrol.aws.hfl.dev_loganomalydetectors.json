{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlLogsLogAnomalyDetector",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsLogAnomalyDetectorCreate",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "logs:CreateLogAnomalyDetector"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsLogAnomalyDetectorRead",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "logs:GetLogAnomalyDetector"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsLogAnomalyDetectorUpdate",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "logs:UpdateLogAnomalyDetector"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsLogAnomalyDetectorDelete",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "logs:DeleteLogAnomalyDetector"
      ],
      "Resource": "*"
    }
  ]
}
