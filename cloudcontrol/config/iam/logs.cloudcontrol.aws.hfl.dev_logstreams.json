{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlLogsLogStream",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsLogStreamCreate",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsLogStreamRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsLogStreamDelete",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteLogStream"
      ],
      "Resource": "*"
    }
  ]
}
