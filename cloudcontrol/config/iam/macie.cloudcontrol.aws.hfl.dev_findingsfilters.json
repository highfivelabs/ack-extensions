{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlMacieFindingsFilter",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MacieFindingsFilterCreate",
      "Effect": "Allow",
      "Action": [
        "macie2:CreateFindingsFilter",
        "macie2:GetFindingsFilter",
        "macie2:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MacieFindingsFilterRead",
      "Effect": "Allow",
      "Action": [
        "macie2:GetFindingsFilter"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MacieFindingsFilterUpdate",
      "Effect": "Allow",
      "Action": [
        "macie2:GetFindingsFilter",
        "macie2:TagResource",
        "macie2:UntagResource",
        "macie2:UpdateFindingsFilter"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MacieFindingsFilterDelete",
      "Effect": "Allow",
      "Action": [
        "macie2:DeleteFindingsFilter"
      ],
      "Resource": "*"
    }
  ]
}
