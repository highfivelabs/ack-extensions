{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControl",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMSAMLProviderCreate",
      "Effect": "Allow",
      "Action": [
        "iam:CreateSAMLProvider",
        "iam:GetSAMLProvider",
        "iam:TagSAMLProvider"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMSAMLProviderRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetSAMLProvider"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMSAMLProviderUpdate",
      "Effect": "Allow",
      "Action": [
        "iam:GetSAMLProvider",
        "iam:ListSAMLProviderTags",
        "iam:TagSAMLProvider",
        "iam:UntagSAMLProvider",
        "iam:UpdateSAMLProvider"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMSAMLProviderDelete",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteSAMLProvider"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TransitGatewayRouteTableCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:CreateTransitGatewayRouteTable",
        "ec2:DescribeTransitGatewayRouteTables"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TransitGatewayRouteTableRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeTransitGatewayRouteTables"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TransitGatewayRouteTableUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:DescribeTransitGatewayRouteTables"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EC2TransitGatewayRouteTableDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteTransitGatewayRouteTable",
        "ec2:DescribeTransitGatewayRouteTables",
        "ec2:DisassociateTransitGatewayRouteTable",
        "ec2:GetTransitGatewayRouteTableAssociations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyDetectorCreate",
      "Effect": "Allow",
      "Action": [
        "guardduty:CreateDetector",
        "guardduty:GetDetector",
        "guardduty:TagResource",
        "iam:CreateServiceLinkedRole",
        "iam:GetRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyDetectorRead",
      "Effect": "Allow",
      "Action": [
        "guardduty:GetDetector",
        "guardduty:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyDetectorUpdate",
      "Effect": "Allow",
      "Action": [
        "guardduty:GetDetector",
        "guardduty:ListDetectors",
        "guardduty:TagResource",
        "guardduty:UntagResource",
        "guardduty:UpdateDetector",
        "iam:CreateServiceLinkedRole",
        "iam:GetRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GuardDutyDetectorDelete",
      "Effect": "Allow",
      "Action": [
        "guardduty:DeleteDetector",
        "guardduty:GetDetector",
        "guardduty:ListDetectors"
      ],
      "Resource": "*"
    }
  ]
}
