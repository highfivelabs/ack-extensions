{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlMediaConvertCertificateAssociation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaConvertCertificateAssociationCreate",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:SearchCertificates",
        "mediaconvert:AssociateCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaConvertCertificateAssociationRead",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaConvertCertificateAssociationDelete",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "mediaconvert:DisassociateCertificate"
      ],
      "Resource": "*"
    }
  ]
}
