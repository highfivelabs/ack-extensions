{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlMediaLiveMultiplex",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaLiveMultiplexCreate",
      "Effect": "Allow",
      "Action": [
        "medialive:CreateMultiplex",
        "medialive:CreateTags",
        "medialive:DescribeMultiplex"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaLiveMultiplexRead",
      "Effect": "Allow",
      "Action": [
        "medialive:DescribeMultiplex"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaLiveMultiplexUpdate",
      "Effect": "Allow",
      "Action": [
        "medialive:CreateTags",
        "medialive:DeleteTags",
        "medialive:DescribeMultiplex",
        "medialive:UpdateMultiplex"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaLiveMultiplexDelete",
      "Effect": "Allow",
      "Action": [
        "medialive:DeleteMultiplex",
        "medialive:DescribeMultiplex"
      ],
      "Resource": "*"
    }
  ]
}
