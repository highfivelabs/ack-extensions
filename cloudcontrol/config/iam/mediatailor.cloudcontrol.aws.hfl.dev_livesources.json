{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlMediaTailorLiveSource",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaTailorLiveSourceCreate",
      "Effect": "Allow",
      "Action": [
        "mediatailor:CreateLiveSource",
        "mediatailor:DescribeLiveSource",
        "mediatailor:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaTailorLiveSourceRead",
      "Effect": "Allow",
      "Action": [
        "mediatailor:DescribeLiveSource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaTailorLiveSourceUpdate",
      "Effect": "Allow",
      "Action": [
        "mediatailor:DescribeLiveSource",
        "mediatailor:TagResource",
        "mediatailor:UntagResource",
        "mediatailor:UpdateLiveSource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaTailorLiveSourceDelete",
      "Effect": "Allow",
      "Action": [
        "mediatailor:DeleteLiveSource",
        "mediatailor:DescribeLiveSource"
      ],
      "Resource": "*"
    }
  ]
}
