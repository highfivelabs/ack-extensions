{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlMediaTailorVodSource",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaTailorVodSourceCreate",
      "Effect": "Allow",
      "Action": [
        "mediatailor:CreateVodSource",
        "mediatailor:DescribeVodSource",
        "mediatailor:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaTailorVodSourceRead",
      "Effect": "Allow",
      "Action": [
        "mediatailor:DescribeVodSource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaTailorVodSourceUpdate",
      "Effect": "Allow",
      "Action": [
        "mediatailor:DescribeVodSource",
        "mediatailor:TagResource",
        "mediatailor:UntagResource",
        "mediatailor:UpdateVodSource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MediaTailorVodSourceDelete",
      "Effect": "Allow",
      "Action": [
        "mediatailor:DeleteVodSource",
        "mediatailor:DescribeVodSource"
      ],
      "Resource": "*"
    }
  ]
}
