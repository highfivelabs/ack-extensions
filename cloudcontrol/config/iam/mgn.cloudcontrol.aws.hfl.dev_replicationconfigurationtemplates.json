{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlMGNReplicationConfigurationTemplate",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MGNReplicationConfigurationTemplateCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:GetEbsDefaultKmsKeyId",
        "ec2:GetEbsEncryptionByDefault",
        "ec2:RevokeSecurityGroupEgress",
        "kms:CreateGrant",
        "kms:DescribeKey",
        "mgn:CreateReplicationConfigurationTemplate",
        "mgn:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MGNReplicationConfigurationTemplateRead",
      "Effect": "Allow",
      "Action": [
        "mgn:DescribeReplicationConfigurationTemplates",
        "mgn:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MGNReplicationConfigurationTemplateUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:GetEbsDefaultKmsKeyId",
        "ec2:GetEbsEncryptionByDefault",
        "ec2:RevokeSecurityGroupEgress",
        "kms:CreateGrant",
        "kms:DescribeKey",
        "mgn:ListTagsForResource",
        "mgn:TagResource",
        "mgn:UntagResource",
        "mgn:UpdateReplicationConfigurationTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MGNReplicationConfigurationTemplateDelete",
      "Effect": "Allow",
      "Action": [
        "mgn:DeleteReplicationConfigurationTemplate"
      ],
      "Resource": "*"
    }
  ]
}
