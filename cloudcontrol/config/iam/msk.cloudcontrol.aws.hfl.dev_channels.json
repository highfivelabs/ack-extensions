{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlMSKChannel",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MSKChannelCreate",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:PutItem",
        "dynamodb:TagResource",
        "firehose:DescribeDeliveryStream",
        "firehose:PutRecord",
        "firehose:PutRecordBatch",
        "firehose:TagDeliveryStream",
        "glue:CreateTable",
        "glue:GetDatabase",
        "glue:GetTable",
        "iam:AttachRolePolicy",
        "iam:CreateServiceLinkedRole",
        "iam:GetRole",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "kafka:CreateChannel",
        "kafka:DescribeChannel",
        "kafka:TagResource",
        "kms:DescribeKey",
        "logs:CreateLogDelivery",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:DescribeLogGroups",
        "logs:DescribeResourcePolicies",
        "logs:GetLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutLogEvents",
        "logs:PutResourcePolicy",
        "logs:UpdateLogDelivery",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutBucketPolicy",
        "s3:PutObject",
        "stepfunctions:DescribeStateMachine",
        "stepfunctions:StartExecution",
        "stepfunctions:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MSKChannelRead",
      "Effect": "Allow",
      "Action": [
        "kafka:DescribeChannel",
        "kafka:ListTagsForResource",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MSKChannelUpdate",
      "Effect": "Allow",
      "Action": [
        "kafka:DescribeChannel",
        "kafka:TagResource",
        "kafka:UntagResource",
        "kafka:UpdateChannel",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MSKChannelDelete",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "kafka:DeleteChannel",
        "kafka:DescribeChannel",
        "kms:DescribeKey",
        "logs:DeleteLogDelivery",
        "logs:ListLogDeliveries",
        "stepfunctions:DescribeStateMachine",
        "stepfunctions:StopExecution"
      ],
      "Resource": "*"
    }
  ]
}
