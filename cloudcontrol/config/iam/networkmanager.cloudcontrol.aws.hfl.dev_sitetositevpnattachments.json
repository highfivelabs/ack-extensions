{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlNetworkManagerSiteToSiteVpnAttachment",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkManagerSiteToSiteVpnAttachmentCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "networkmanager:CreateSiteToSiteVpnAttachment",
        "networkmanager:GetSiteToSiteVpnAttachment",
        "networkmanager:ListAttachmentNatConfigurations",
        "networkmanager:TagResource",
        "networkmanager:UpdateAttachmentNatConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkManagerSiteToSiteVpnAttachmentRead",
      "Effect": "Allow",
      "Action": [
        "networkmanager:GetSiteToSiteVpnAttachment"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkManagerSiteToSiteVpnAttachmentUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "networkmanager:GetSiteToSiteVpnAttachment",
        "networkmanager:ListAttachmentNatConfigurations",
        "networkmanager:ListAttachmentRoutingPolicyAssociations",
        "networkmanager:ListTagsForResource",
        "networkmanager:PutAttachmentRoutingPolicyLabel",
        "networkmanager:RemoveAttachmentRoutingPolicyLabel",
        "networkmanager:TagResource",
        "networkmanager:UntagResource",
        "networkmanager:UpdateAttachmentNatConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NetworkManagerSiteToSiteVpnAttachmentDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "networkmanager:DeleteAttachment",
        "networkmanager:GetSiteToSiteVpnAttachment"
      ],
      "Resource": "*"
    }
  ]
}
