{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlPanoramaApplicationInstance",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaApplicationInstanceCreate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "panorama:CreateApplicationInstance",
        "panorama:DescribeApplicationInstance",
        "panorama:DescribeApplicationInstanceDetails",
        "panorama:ListTagsForResource",
        "panorama:TagResource",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaApplicationInstanceRead",
      "Effect": "Allow",
      "Action": [
        "panorama:DescribeApplicationInstance",
        "panorama:DescribeApplicationInstanceDetails",
        "panorama:ListTagsForResource",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListObjects"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaApplicationInstanceUpdate",
      "Effect": "Allow",
      "Action": [
        "panorama:DescribeApplicationInstance",
        "panorama:DescribeApplicationInstanceDetails",
        "panorama:ListTagsForResource",
        "panorama:TagResource",
        "panorama:UntagResource",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListObjects"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaApplicationInstanceDelete",
      "Effect": "Allow",
      "Action": [
        "panorama:DescribeApplicationInstance",
        "panorama:DescribeApplicationInstanceDetails",
        "panorama:RemoveApplicationInstance",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteObjectVersionTagging",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListObjects"
      ],
      "Resource": "*"
    }
  ]
}
