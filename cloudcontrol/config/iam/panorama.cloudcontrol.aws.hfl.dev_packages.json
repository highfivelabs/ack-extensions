{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlPanoramaPackage",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaPackageCreate",
      "Effect": "Allow",
      "Action": [
        "panorama:CreatePackage",
        "panorama:DescribePackage",
        "panorama:ListTagsForResource",
        "panorama:TagResource",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaPackageRead",
      "Effect": "Allow",
      "Action": [
        "panorama:DescribePackage",
        "panorama:ListTagsForResource",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaPackageUpdate",
      "Effect": "Allow",
      "Action": [
        "panorama:DescribePackage",
        "panorama:ListTagsForResource",
        "panorama:TagResource",
        "panorama:UntagResource",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaPackageDelete",
      "Effect": "Allow",
      "Action": [
        "panorama:DeletePackage",
        "panorama:DescribePackage",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteObjectVersionTagging",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:ListObjects",
        "s3:ListObjectsV2"
      ],
      "Resource": "*"
    }
  ]
}
