{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlPanoramaPackageVersion",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaPackageVersionCreate",
      "Effect": "Allow",
      "Action": [
        "panorama:DescribePackageVersion",
        "panorama:RegisterPackageVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaPackageVersionRead",
      "Effect": "Allow",
      "Action": [
        "panorama:DescribePackageVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaPackageVersionUpdate",
      "Effect": "Allow",
      "Action": [
        "panorama:DescribePackageVersion",
        "panorama:RegisterPackageVersion",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PanoramaPackageVersionDelete",
      "Effect": "Allow",
      "Action": [
        "panorama:DeregisterPackageVersion",
        "panorama:DescribePackageVersion",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteObjectVersionTagging",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket"
      ],
      "Resource": "*"
    }
  ]
}
