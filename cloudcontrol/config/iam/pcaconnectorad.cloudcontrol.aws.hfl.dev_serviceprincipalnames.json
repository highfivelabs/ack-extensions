{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlPCAConnectorADServicePrincipalName",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PCAConnectorADServicePrincipalNameCreate",
      "Effect": "Allow",
      "Action": [
        "ds:UpdateAuthorizedApplication",
        "pca-connector-ad:CreateServicePrincipalName",
        "pca-connector-ad:GetServicePrincipalName"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PCAConnectorADServicePrincipalNameRead",
      "Effect": "Allow",
      "Action": [
        "pca-connector-ad:GetServicePrincipalName"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PCAConnectorADServicePrincipalNameDelete",
      "Effect": "Allow",
      "Action": [
        "ds:UpdateAuthorizedApplication",
        "pca-connector-ad:DeleteServicePrincipalName",
        "pca-connector-ad:GetServicePrincipalName"
      ],
      "Resource": "*"
    }
  ]
}
