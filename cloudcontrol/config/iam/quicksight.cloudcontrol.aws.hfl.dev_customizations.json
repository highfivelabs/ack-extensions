{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlQuickSightCustomization",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QuickSightCustomizationCreate",
      "Effect": "Allow",
      "Action": [
        "quicksight:CreateAccountCustomization",
        "quicksight:DescribeAccountCustomization",
        "quicksight:ListTagsForResource",
        "quicksight:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QuickSightCustomizationRead",
      "Effect": "Allow",
      "Action": [
        "quicksight:DescribeAccountCustomization",
        "quicksight:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QuickSightCustomizationUpdate",
      "Effect": "Allow",
      "Action": [
        "quicksight:TagResource",
        "quicksight:UntagResource",
        "quicksight:UpdateAccountCustomization"
      ],
      "Resource": "*"
    },
    {
      "Sid": "QuickSightCustomizationDelete",
      "Effect": "Allow",
      "Action": [
        "quicksight:DeleteAccountCustomization"
      ],
      "Resource": "*"
    }
  ]
}
