{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlRekognitionStreamProcessor",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RekognitionStreamProcessorCreate",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole",
        "rekognition:CreateStreamProcessor",
        "rekognition:DescribeStreamProcessor",
        "rekognition:ListTagsForResource",
        "rekognition:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RekognitionStreamProcessorRead",
      "Effect": "Allow",
      "Action": [
        "rekognition:DescribeStreamProcessor",
        "rekognition:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RekognitionStreamProcessorUpdate",
      "Effect": "Allow",
      "Action": [
        "rekognition:DescribeStreamProcessor",
        "rekognition:ListTagsForResource",
        "rekognition:TagResource",
        "rekognition:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RekognitionStreamProcessorDelete",
      "Effect": "Allow",
      "Action": [
        "rekognition:DeleteStreamProcessor"
      ],
      "Resource": "*"
    }
  ]
}
