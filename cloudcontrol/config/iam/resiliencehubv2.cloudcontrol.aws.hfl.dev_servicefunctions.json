{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlResilienceHubV2ServiceFunction",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResilienceHubV2ServiceFunctionCreate",
      "Effect": "Allow",
      "Action": [
        "resiliencehub:CreateServiceFunction",
        "resiliencehub:ListServiceFunctions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResilienceHubV2ServiceFunctionRead",
      "Effect": "Allow",
      "Action": [
        "resiliencehub:ListServiceFunctions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResilienceHubV2ServiceFunctionUpdate",
      "Effect": "Allow",
      "Action": [
        "resiliencehub:ListServiceFunctions",
        "resiliencehub:UpdateServiceFunction"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResilienceHubV2ServiceFunctionDelete",
      "Effect": "Allow",
      "Action": [
        "resiliencehub:DeleteServiceFunction"
      ],
      "Resource": "*"
    }
  ]
}
