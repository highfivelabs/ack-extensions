{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlRoboMakerFleet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RoboMakerFleetCreate",
      "Effect": "Allow",
      "Action": [
        "robomaker:CreateFleet"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RoboMakerFleetRead",
      "Effect": "Allow",
      "Action": [
        "robomaker:DescribeFleet"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RoboMakerFleetUpdate",
      "Effect": "Allow",
      "Action": [
        "robomaker:TagResource",
        "robomaker:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RoboMakerFleetDelete",
      "Effect": "Allow",
      "Action": [
        "robomaker:DeleteFleet"
      ],
      "Resource": "*"
    }
  ]
}
