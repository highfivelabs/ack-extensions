{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlRoute53DNSSEC",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53DNSSECCreate",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:GetPublicKey",
        "kms:Sign",
        "route53:EnableHostedZoneDNSSEC",
        "route53:GetDNSSEC"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53DNSSECRead",
      "Effect": "Allow",
      "Action": [
        "route53:GetDNSSEC"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53DNSSECDelete",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:DescribeKey",
        "kms:GetPublicKey",
        "kms:Sign",
        "route53:DisableHostedZoneDNSSEC",
        "route53:GetDNSSEC"
      ],
      "Resource": "*"
    }
  ]
}
