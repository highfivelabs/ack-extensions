{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlRoute53QueryLoggingConfig",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53QueryLoggingConfigCreate",
      "Effect": "Allow",
      "Action": [
        "route53:CreateQueryLoggingConfig"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53QueryLoggingConfigRead",
      "Effect": "Allow",
      "Action": [
        "route53:GetQueryLoggingConfig"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53QueryLoggingConfigDelete",
      "Effect": "Allow",
      "Action": [
        "route53:DeleteQueryLoggingConfig"
      ],
      "Resource": "*"
    }
  ]
}
