{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlRoute53TrafficPolicy",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53TrafficPolicyCreate",
      "Effect": "Allow",
      "Action": [
        "route53:CreateTrafficPolicy",
        "route53:ListTrafficPolicyVersions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53TrafficPolicyRead",
      "Effect": "Allow",
      "Action": [
        "route53:ListTrafficPolicyVersions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53TrafficPolicyUpdate",
      "Effect": "Allow",
      "Action": [
        "route53:ListTrafficPolicyVersions",
        "route53:UpdateTrafficPolicyComment"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53TrafficPolicyDelete",
      "Effect": "Allow",
      "Action": [
        "route53:DeleteTrafficPolicy",
        "route53:ListTrafficPolicyVersions"
      ],
      "Resource": "*"
    }
  ]
}
