{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlRoute53TrafficPolicyInstance",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53TrafficPolicyInstanceCreate",
      "Effect": "Allow",
      "Action": [
        "route53:CreateTrafficPolicyInstance",
        "route53:GetTrafficPolicyInstance"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53TrafficPolicyInstanceRead",
      "Effect": "Allow",
      "Action": [
        "route53:GetTrafficPolicyInstance"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53TrafficPolicyInstanceUpdate",
      "Effect": "Allow",
      "Action": [
        "route53:GetTrafficPolicyInstance",
        "route53:UpdateTrafficPolicyInstance"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53TrafficPolicyInstanceDelete",
      "Effect": "Allow",
      "Action": [
        "route53:DeleteTrafficPolicyInstance",
        "route53:GetTrafficPolicyInstance"
      ],
      "Resource": "*"
    }
  ]
}
