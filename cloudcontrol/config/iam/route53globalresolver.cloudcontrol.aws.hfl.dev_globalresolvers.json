{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlRoute53GlobalResolverGlobalResolver",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53GlobalResolverGlobalResolverCreate",
      "Effect": "Allow",
      "Action": [
        "route53globalresolver:CreateGlobalResolver",
        "route53globalresolver:GetGlobalResolver",
        "route53globalresolver:ListTagsForResource",
        "route53globalresolver:TagResource",
        "route53globalresolver:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53GlobalResolverGlobalResolverRead",
      "Effect": "Allow",
      "Action": [
        "route53globalresolver:GetGlobalResolver",
        "route53globalresolver:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53GlobalResolverGlobalResolverUpdate",
      "Effect": "Allow",
      "Action": [
        "route53globalresolver:GetGlobalResolver",
        "route53globalresolver:ListTagsForResource",
        "route53globalresolver:TagResource",
        "route53globalresolver:UntagResource",
        "route53globalresolver:UpdateGlobalResolver"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53GlobalResolverGlobalResolverDelete",
      "Effect": "Allow",
      "Action": [
        "route53globalresolver:DeleteGlobalResolver",
        "route53globalresolver:GetGlobalResolver"
      ],
      "Resource": "*"
    }
  ]
}
