{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlRoute53ResolverFirewallRuleGroupAssociation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53ResolverFirewallRuleGroupAssociationCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "route53resolver:AssociateFirewallRuleGroup",
        "route53resolver:GetFirewallRuleGroupAssociation",
        "route53resolver:ListTagsForResource",
        "route53resolver:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53ResolverFirewallRuleGroupAssociationRead",
      "Effect": "Allow",
      "Action": [
        "route53resolver:GetFirewallRuleGroupAssociation",
        "route53resolver:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53ResolverFirewallRuleGroupAssociationUpdate",
      "Effect": "Allow",
      "Action": [
        "route53resolver:GetFirewallRuleGroupAssociation",
        "route53resolver:ListTagsForResource",
        "route53resolver:TagResource",
        "route53resolver:UntagResource",
        "route53resolver:UpdateFirewallRuleGroupAssociation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53ResolverFirewallRuleGroupAssociationDelete",
      "Effect": "Allow",
      "Action": [
        "route53resolver:DisassociateFirewallRuleGroup",
        "route53resolver:GetFirewallRuleGroupAssociation",
        "route53resolver:ListTagsForResource",
        "route53resolver:UntagResource"
      ],
      "Resource": "*"
    }
  ]
}
