{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlS3FilesFileSystemPolicy",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3FilesFileSystemPolicyCreate",
      "Effect": "Allow",
      "Action": [
        "s3files:GetFileSystemPolicy",
        "s3files:PutFileSystemPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3FilesFileSystemPolicyRead",
      "Effect": "Allow",
      "Action": [
        "s3files:GetFileSystemPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3FilesFileSystemPolicyUpdate",
      "Effect": "Allow",
      "Action": [
        "s3files:GetFileSystemPolicy",
        "s3files:PutFileSystemPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3FilesFileSystemPolicyDelete",
      "Effect": "Allow",
      "Action": [
        "s3files:DeleteFileSystemPolicy",
        "s3files:GetFileSystemPolicy"
      ],
      "Resource": "*"
    }
  ]
}
