{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlS3OutpostsBucket",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3OutpostsBucketCreate",
      "Effect": "Allow",
      "Action": [
        "s3-outposts:CreateBucket",
        "s3-outposts:PutBucketTagging",
        "s3-outposts:PutLifecycleConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3OutpostsBucketRead",
      "Effect": "Allow",
      "Action": [
        "s3-outposts:GetBucket",
        "s3-outposts:GetBucketTagging",
        "s3-outposts:GetLifecycleConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3OutpostsBucketUpdate",
      "Effect": "Allow",
      "Action": [
        "s3-outposts:DeleteBucketTagging",
        "s3-outposts:PutBucketTagging",
        "s3-outposts:PutLifecycleConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3OutpostsBucketDelete",
      "Effect": "Allow",
      "Action": [
        "s3-outposts:DeleteBucket"
      ],
      "Resource": "*"
    }
  ]
}
