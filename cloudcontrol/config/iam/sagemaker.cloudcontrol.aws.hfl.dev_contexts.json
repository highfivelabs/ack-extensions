{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlSageMakerContext",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SageMakerContextCreate",
      "Effect": "Allow",
      "Action": [
        "sagemaker:AddTags",
        "sagemaker:CreateContext",
        "sagemaker:DescribeContext",
        "sagemaker:ListTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SageMakerContextRead",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DescribeContext",
        "sagemaker:ListTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SageMakerContextUpdate",
      "Effect": "Allow",
      "Action": [
        "sagemaker:AddTags",
        "sagemaker:DeleteTags",
        "sagemaker:DescribeContext",
        "sagemaker:ListTags",
        "sagemaker:UpdateContext"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SageMakerContextDelete",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DeleteContext",
        "sagemaker:DescribeContext",
        "sagemaker:ListTags"
      ],
      "Resource": "*"
    }
  ]
}
