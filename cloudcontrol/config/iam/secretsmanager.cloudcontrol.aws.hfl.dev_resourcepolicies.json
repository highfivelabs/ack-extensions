{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlSecretsManagerResourcePolicy",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManagerResourcePolicyCreate",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:PutResourcePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManagerResourcePolicyRead",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetResourcePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManagerResourcePolicyUpdate",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:PutResourcePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManagerResourcePolicyDelete",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DeleteResourcePolicy",
        "secretsmanager:GetResourcePolicy"
      ],
      "Resource": "*"
    }
  ]
}
