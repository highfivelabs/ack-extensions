{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlSecurityAgentIntegration",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityAgentIntegrationCreate",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo",
        "securityagent:CreateIntegration",
        "securityagent:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityAgentIntegrationRead",
      "Effect": "Allow",
      "Action": [
        "securityagent:GetIntegration",
        "securityagent:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityAgentIntegrationUpdate",
      "Effect": "Allow",
      "Action": [
        "securityagent:GetIntegration",
        "securityagent:ListTagsForResource",
        "securityagent:TagResource",
        "securityagent:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityAgentIntegrationDelete",
      "Effect": "Allow",
      "Action": [
        "securityagent:DeleteIntegration",
        "securityagent:GetIntegration",
        "securityagent:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
