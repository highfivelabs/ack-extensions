{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlSecurityHubAutomationRuleV2",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubAutomationRuleV2Create",
      "Effect": "Allow",
      "Action": [
        "securityhub:CreateAutomationRuleV2",
        "securityhub:GetAutomationRuleV2",
        "securityhub:ListTagsForResource",
        "securityhub:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubAutomationRuleV2Read",
      "Effect": "Allow",
      "Action": [
        "securityhub:GetAutomationRuleV2",
        "securityhub:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubAutomationRuleV2Update",
      "Effect": "Allow",
      "Action": [
        "securityhub:GetAutomationRuleV2",
        "securityhub:ListTagsForResource",
        "securityhub:TagResource",
        "securityhub:UntagResource",
        "securityhub:UpdateAutomationRuleV2"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubAutomationRuleV2Delete",
      "Effect": "Allow",
      "Action": [
        "securityhub:DeleteAutomationRuleV2",
        "securityhub:GetAutomationRuleV2"
      ],
      "Resource": "*"
    }
  ]
}
