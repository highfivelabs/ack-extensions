{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlSecurityHubConnectorV2",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubConnectorV2Create",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "securityhub:CreateConnectorV2",
        "securityhub:GetConnectorV2",
        "securityhub:ListConnectorsV2",
        "securityhub:ListTagsForResource",
        "securityhub:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubConnectorV2Read",
      "Effect": "Allow",
      "Action": [
        "securityhub:GetConnectorV2",
        "securityhub:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubConnectorV2Update",
      "Effect": "Allow",
      "Action": [
        "securityhub:GetConnectorV2",
        "securityhub:ListConnectorsV2",
        "securityhub:ListTagsForResource",
        "securityhub:TagResource",
        "securityhub:UntagResource",
        "securityhub:UpdateConnectorV2"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubConnectorV2Delete",
      "Effect": "Allow",
      "Action": [
        "securityhub:DeleteConnectorV2",
        "securityhub:GetConnectorV2",
        "securityhub:ListConnectorsV2"
      ],
      "Resource": "*"
    }
  ]
}
