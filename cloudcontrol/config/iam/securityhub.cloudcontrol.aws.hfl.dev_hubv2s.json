{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlSecurityHubHubV2",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubHubV2Create",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole",
        "securityhub:DescribeSecurityHubV2",
        "securityhub:DisableSecurityHubFeatureV2",
        "securityhub:EnableSecurityHubFeatureV2",
        "securityhub:EnableSecurityHubV2",
        "securityhub:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubHubV2Read",
      "Effect": "Allow",
      "Action": [
        "securityhub:DescribeSecurityHubV2",
        "securityhub:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubHubV2Update",
      "Effect": "Allow",
      "Action": [
        "securityhub:DescribeSecurityHubV2",
        "securityhub:DisableSecurityHubFeatureV2",
        "securityhub:EnableSecurityHubFeatureV2",
        "securityhub:ListTagsForResource",
        "securityhub:TagResource",
        "securityhub:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecurityHubHubV2Delete",
      "Effect": "Allow",
      "Action": [
        "securityhub:DescribeSecurityHubV2",
        "securityhub:DisableSecurityHubV2"
      ],
      "Resource": "*"
    }
  ]
}
