{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlServiceCatalogLaunchRoleConstraint",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceCatalogLaunchRoleConstraintCreate",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:PassRole",
        "servicecatalog:CreateConstraint",
        "servicecatalog:DescribeConstraint"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceCatalogLaunchRoleConstraintRead",
      "Effect": "Allow",
      "Action": [
        "servicecatalog:DescribeConstraint"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceCatalogLaunchRoleConstraintUpdate",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:PassRole",
        "servicecatalog:DescribeConstraint",
        "servicecatalog:UpdateConstraint"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceCatalogLaunchRoleConstraintDelete",
      "Effect": "Allow",
      "Action": [
        "servicecatalog:DeleteConstraint"
      ],
      "Resource": "*"
    }
  ]
}
