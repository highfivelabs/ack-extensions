{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlServiceDiscoveryPrivateDnsNamespace",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceDiscoveryPrivateDnsNamespaceCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRegions",
        "ec2:DescribeVpcs",
        "route53:CreateHostedZone",
        "route53:GetHostedZone",
        "route53:ListHostedZonesByName",
        "servicediscovery:CreatePrivateDnsNamespace",
        "servicediscovery:GetNamespace",
        "servicediscovery:GetOperation",
        "servicediscovery:ListTagsForResource",
        "servicediscovery:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceDiscoveryPrivateDnsNamespaceRead",
      "Effect": "Allow",
      "Action": [
        "servicediscovery:GetNamespace",
        "servicediscovery:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceDiscoveryPrivateDnsNamespaceUpdate",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "servicediscovery:GetNamespace",
        "servicediscovery:GetOperation",
        "servicediscovery:ListTagsForResource",
        "servicediscovery:TagResource",
        "servicediscovery:UntagResource",
        "servicediscovery:UpdatePrivateDnsNamespace"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ServiceDiscoveryPrivateDnsNamespaceDelete",
      "Effect": "Allow",
      "Action": [
        "servicediscovery:DeleteNamespace",
        "servicediscovery:GetOperation"
      ],
      "Resource": "*"
    }
  ]
}
