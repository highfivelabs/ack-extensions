{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlSESMailManagerArchive",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SESMailManagerArchiveCreate",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "ses:CreateArchive",
        "ses:GetArchive",
        "ses:ListTagsForResource",
        "ses:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SESMailManagerArchiveRead",
      "Effect": "Allow",
      "Action": [
        "ses:GetArchive",
        "ses:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SESMailManagerArchiveUpdate",
      "Effect": "Allow",
      "Action": [
        "ses:GetArchive",
        "ses:ListTagsForResource",
        "ses:TagResource",
        "ses:UntagResource",
        "ses:UpdateArchive"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SESMailManagerArchiveDelete",
      "Effect": "Allow",
      "Action": [
        "ses:DeleteArchive",
        "ses:GetArchive"
      ],
      "Resource": "*"
    }
  ]
}
