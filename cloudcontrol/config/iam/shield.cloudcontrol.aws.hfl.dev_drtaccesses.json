{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlShieldDRTAccess",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ShieldDRTAccessCreate",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:PassRole",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "shield:AssociateDRTLogBucket",
        "shield:AssociateDRTRole",
        "shield:DescribeDRTAccess"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ShieldDRTAccessRead",
      "Effect": "Allow",
      "Action": [
        "shield:DescribeDRTAccess"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ShieldDRTAccessUpdate",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:PassRole",
        "s3:DeleteBucketPolicy",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "shield:AssociateDRTLogBucket",
        "shield:AssociateDRTRole",
        "shield:DescribeDRTAccess",
        "shield:DisassociateDRTLogBucket",
        "shield:DisassociateDRTRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ShieldDRTAccessDelete",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:PassRole",
        "s3:DeleteBucketPolicy",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "shield:DescribeDRTAccess",
        "shield:DisassociateDRTLogBucket",
        "shield:DisassociateDRTRole"
      ],
      "Resource": "*"
    }
  ]
}
