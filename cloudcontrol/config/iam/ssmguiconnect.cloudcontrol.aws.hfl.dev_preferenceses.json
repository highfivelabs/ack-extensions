{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlSSMGuiConnectPreferences",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SSMGuiConnectPreferencesCreate",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "ssm-guiconnect:GetConnectionRecordingPreferences",
        "ssm-guiconnect:UpdateConnectionRecordingPreferences"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SSMGuiConnectPreferencesRead",
      "Effect": "Allow",
      "Action": [
        "ssm-guiconnect:GetConnectionRecordingPreferences"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SSMGuiConnectPreferencesUpdate",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "ssm-guiconnect:DeleteConnectionRecordingPreferences",
        "ssm-guiconnect:GetConnectionRecordingPreferences",
        "ssm-guiconnect:UpdateConnectionRecordingPreferences"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SSMGuiConnectPreferencesDelete",
      "Effect": "Allow",
      "Action": [
        "ssm-guiconnect:DeleteConnectionRecordingPreferences",
        "ssm-guiconnect:GetConnectionRecordingPreferences"
      ],
      "Resource": "*"
    }
  ]
}
