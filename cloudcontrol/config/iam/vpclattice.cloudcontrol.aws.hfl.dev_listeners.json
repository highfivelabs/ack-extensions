{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlVpcLatticeListener",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcLatticeListenerCreate",
      "Effect": "Allow",
      "Action": [
        "vpc-lattice:CreateListener",
        "vpc-lattice:GetListener",
        "vpc-lattice:ListTagsForResource",
        "vpc-lattice:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcLatticeListenerRead",
      "Effect": "Allow",
      "Action": [
        "vpc-lattice:GetListener",
        "vpc-lattice:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcLatticeListenerUpdate",
      "Effect": "Allow",
      "Action": [
        "vpc-lattice:GetListener",
        "vpc-lattice:ListTagsForResource",
        "vpc-lattice:TagResource",
        "vpc-lattice:UntagResource",
        "vpc-lattice:UpdateListener"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcLatticeListenerDelete",
      "Effect": "Allow",
      "Action": [
        "vpc-lattice:DeleteListener"
      ],
      "Resource": "*"
    }
  ]
}
