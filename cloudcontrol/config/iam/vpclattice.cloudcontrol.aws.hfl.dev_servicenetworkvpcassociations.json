{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlVpcLatticeServiceNetworkVpcAssociation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcLatticeServiceNetworkVpcAssociationCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcs",
        "vpc-lattice:CreateServiceNetworkVpcAssociation",
        "vpc-lattice:GetServiceNetworkVpcAssociation",
        "vpc-lattice:ListServiceNetworkVpcAssociations",
        "vpc-lattice:ListTagsForResource",
        "vpc-lattice:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcLatticeServiceNetworkVpcAssociationRead",
      "Effect": "Allow",
      "Action": [
        "vpc-lattice:GetServiceNetworkVpcAssociation",
        "vpc-lattice:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcLatticeServiceNetworkVpcAssociationUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "vpc-lattice:GetServiceNetworkVpcAssociation",
        "vpc-lattice:ListTagsForResource",
        "vpc-lattice:TagResource",
        "vpc-lattice:UntagResource",
        "vpc-lattice:UpdateServiceNetworkVpcAssociation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcLatticeServiceNetworkVpcAssociationDelete",
      "Effect": "Allow",
      "Action": [
        "vpc-lattice:DeleteServiceNetworkVpcAssociation",
        "vpc-lattice:GetServiceNetworkVpcAssociation",
        "vpc-lattice:UntagResource"
      ],
      "Resource": "*"
    }
  ]
}
