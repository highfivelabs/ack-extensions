{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlWellArchitectedAgentContext",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WellArchitectedAgentContextCreate",
      "Effect": "Allow",
      "Action": [
        "wellarchitected:CreateAgentContext",
        "wellarchitected:GetAgentContext"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WellArchitectedAgentContextRead",
      "Effect": "Allow",
      "Action": [
        "wellarchitected:GetAgentContext"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WellArchitectedAgentContextUpdate",
      "Effect": "Allow",
      "Action": [
        "wellarchitected:GetAgentContext",
        "wellarchitected:UpdateAgentContext"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WellArchitectedAgentContextDelete",
      "Effect": "Allow",
      "Action": [
        "wellarchitected:DeleteAgentContext",
        "wellarchitected:GetAgentContext"
      ],
      "Resource": "*"
    }
  ]
}
