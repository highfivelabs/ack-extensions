{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlWellArchitectedAgentProfilePolicy",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WellArchitectedAgentProfilePolicyCreate",
      "Effect": "Allow",
      "Action": [
        "wellarchitected:GetAgentProfilePolicy",
        "wellarchitected:PutAgentProfilePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WellArchitectedAgentProfilePolicyRead",
      "Effect": "Allow",
      "Action": [
        "wellarchitected:GetAgentProfilePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WellArchitectedAgentProfilePolicyUpdate",
      "Effect": "Allow",
      "Action": [
        "wellarchitected:GetAgentProfilePolicy",
        "wellarchitected:PutAgentProfilePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WellArchitectedAgentProfilePolicyDelete",
      "Effect": "Allow",
      "Action": [
        "wellarchitected:DeleteAgentProfilePolicy",
        "wellarchitected:GetAgentProfilePolicy"
      ],
      "Resource": "*"
    }
  ]
}
