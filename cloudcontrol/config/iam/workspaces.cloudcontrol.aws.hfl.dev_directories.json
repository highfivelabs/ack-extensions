{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlWorkSpacesDirectory",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesDirectoryCreate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcs",
        "iam:GetRole",
        "iam:PassRole",
        "workspaces:AssociateIpGroups",
        "workspaces:CreateTags",
        "workspaces:DescribeWorkspaceDirectories",
        "workspaces:ModifyCertificateBasedAuthProperties",
        "workspaces:ModifyEndpointEncryptionMode",
        "workspaces:ModifySamlProperties",
        "workspaces:ModifySelfservicePermissions",
        "workspaces:ModifyStreamingProperties",
        "workspaces:ModifyWorkspaceAccessProperties",
        "workspaces:ModifyWorkspaceCreationProperties",
        "workspaces:RegisterWorkspaceDirectory"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesDirectoryRead",
      "Effect": "Allow",
      "Action": [
        "workspaces:DescribeTags",
        "workspaces:DescribeWorkspaceDirectories"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesDirectoryUpdate",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcEndpoints",
        "ec2:DescribeVpcs",
        "iam:GetRole",
        "iam:PassRole",
        "workspaces:AssociateIpGroups",
        "workspaces:CreateTags",
        "workspaces:DeleteTags",
        "workspaces:DescribeTags",
        "workspaces:DescribeWorkspaceDirectories",
        "workspaces:DisassociateIpGroups",
        "workspaces:ModifyCertificateBasedAuthProperties",
        "workspaces:ModifyEndpointEncryptionMode",
        "workspaces:ModifySamlProperties",
        "workspaces:ModifySelfservicePermissions",
        "workspaces:ModifyStreamingProperties",
        "workspaces:ModifyWorkspaceAccessProperties",
        "workspaces:ModifyWorkspaceCreationProperties"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesDirectoryDelete",
      "Effect": "Allow",
      "Action": [
        "workspaces:DeregisterWorkspaceDirectory",
        "workspaces:DescribeTags",
        "workspaces:DescribeWorkspaceDirectories"
      ],
      "Resource": "*"
    }
  ]
}
