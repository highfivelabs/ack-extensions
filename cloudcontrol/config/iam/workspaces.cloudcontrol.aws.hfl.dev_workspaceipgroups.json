{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlWorkSpacesWorkspaceIpGroup",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesWorkspaceIpGroupCreate",
      "Effect": "Allow",
      "Action": [
        "workspaces:CreateIpGroup",
        "workspaces:CreateTags",
        "workspaces:DescribeIpGroups",
        "workspaces:DescribeTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesWorkspaceIpGroupRead",
      "Effect": "Allow",
      "Action": [
        "workspaces:DescribeIpGroups",
        "workspaces:DescribeTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesWorkspaceIpGroupUpdate",
      "Effect": "Allow",
      "Action": [
        "workspaces:AuthorizeIpRules",
        "workspaces:CreateTags",
        "workspaces:DeleteTags",
        "workspaces:DescribeIpGroups",
        "workspaces:DescribeTags",
        "workspaces:RevokeIpRules",
        "workspaces:UpdateRulesOfIpGroup"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesWorkspaceIpGroupDelete",
      "Effect": "Allow",
      "Action": [
        "workspaces:DeleteIpGroup",
        "workspaces:DescribeIpGroups"
      ],
      "Resource": "*"
    }
  ]
}
