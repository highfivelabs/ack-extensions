{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudControlWorkSpacesWebIpAccessSettings",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateResource",
        "cloudformation:DeleteResource",
        "cloudformation:GetResource",
        "cloudformation:GetResourceRequestStatus",
        "cloudformation:UpdateResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesWebIpAccessSettingsCreate",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo",
        "workspaces-web:CreateIpAccessSettings",
        "workspaces-web:GetIpAccessSettings",
        "workspaces-web:ListIpAccessSettings",
        "workspaces-web:ListTagsForResource",
        "workspaces-web:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesWebIpAccessSettingsRead",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "workspaces-web:GetIpAccessSettings",
        "workspaces-web:ListIpAccessSettings",
        "workspaces-web:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesWebIpAccessSettingsUpdate",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "workspaces-web:GetIpAccessSettings",
        "workspaces-web:ListIpAccessSettings",
        "workspaces-web:ListTagsForResource",
        "workspaces-web:TagResource",
        "workspaces-web:UntagResource",
        "workspaces-web:UpdateIpAccessSettings"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesWebIpAccessSettingsDelete",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "workspaces-web:DeleteIpAccessSettings",
        "workspaces-web:GetIpAccessSettings",
        "workspaces-web:ListIpAccessSettings"
      ],
      "Resource": "*"
    }
  ]
}
